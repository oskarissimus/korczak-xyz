rules_version = '2';

// What may be put in `korczak-xyz-501720-sloper`, which is the only bucket this site's clients
// ever touch. It holds one thing: the pictures, narrations and finished MP4s of `/apps/sloper/`,
// under `users/{uid}/sloper/{projectId}/`.
//
// The shape deliberately mirrors `firestore.rules`: a per-account subtree, owner-only, with the
// path itself carrying the authorization. What it does NOT mirror is the household share — there
// is no `hasShare()` here and there should not be one. The sleep log and the shopping list are
// shared because a household is one household; a video somebody is paying OpenAI to make is not,
// and a share granted for a shopping list must not quietly reach into somebody's drafts.
//
// There is no catch-all beneath this block, so anything outside `users/{uid}/` is denied by
// default. That is the intended state: no part of this site writes anywhere else, and a new app
// that needs to should have to say so here.
//
// WHY `firebase.json` NAMES THE BUCKET, WHICH NOTHING ELSE IN THAT FILE DOES. The `storage` key
// takes either an object or an array, and the difference is not cosmetic: given a bare object the
// CLI resolves the project's DEFAULT bucket and refuses the whole deploy with "Firebase Storage
// has not been set up on project …" when there is not one. There is not one here and there cannot
// be — a default bucket is a `.firebasestorage.app` name that only the console's "Get Started"
// button creates, which is a click nobody can put in git. So the array form names the bucket
// Terraform made, and the CLI skips that lookup entirely. Deleting the `bucket` line to tidy it
// re-breaks the deploy.
service firebase.storage {
  match /b/{bucket}/o {
    /*
     * The same admissions gate `firestore.rules` is built on, reached across the service boundary.
     *
     * Signing in stopped being the same thing as being let in when self-service sign-up was turned
     * on: `accounts/{uid}.approved` is the verdict, and it lives in Firestore because that is where
     * the panel that writes it and every other rule that reads it are. Storage rules can read it —
     * `firestore.get()` against the DEFAULT database only — and the alternative was to leave this
     * bucket open to anybody who can complete a sign-up form, on the reasoning that the app would
     * not let them. The app is not the gate.
     *
     * TWO THINGS THIS DEPENDS ON, neither of them visible from here:
     *
     *   - An IAM grant. The lookup runs as the Cloud Storage for Firebase service agent, which
     *     needs `roles/firebaserules.firestoreServiceAgent` to make it. That grant is
     *     `firebasestorage_reads_firestore` in `terraform/iam.tf`, and the deploy workflow runs
     *     Terraform before the rules for exactly this class of ordering. Without it every upload
     *     fails closed, which at least fails in the safe direction.
     *   - A missing account document denies. `firestore.get()` on a document that is not there
     *     returns null and reading `.data` off null is an evaluation error, which is a denial —
     *     the same reasoning as the Firestore side, where the same sentence appears.
     */
    function approved() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/accounts/$(request.auth.uid)).data.approved == true;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if approved() && request.auth.uid == uid;

      // WHY THERE IS A SIZE CAP AT ALL. Nothing else bounds an upload: the client decides what to
      // send, and a bug — or a browser tab left open on a page that retries — can write the same
      // object over and over. 64 MiB is twice the 32 MiB the assembler will accept in either
      // direction, so it cannot refuse anything the app can legitimately produce, while still
      // being a number rather than no number.
      allow write: if approved()
        && request.auth.uid == uid
        && request.resource.size < 64 * 1024 * 1024;

      // Spelt out beside `write`, which in Storage rules already covers it. It has to be: on a
      // delete there is no `request.resource`, so the size clause above evaluates to an error and
      // denies — and rules are a permissive union, so this second block is what grants it back.
      // Nothing in the app deletes yet; the alternative is a bucket that can only ever grow.
      allow delete: if approved() && request.auth.uid == uid;
    }
  }
}
