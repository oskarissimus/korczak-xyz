/**
 * korczak.xyz — a Worker that is nothing but its static assets.
 *
 * There is no `main`, and that is the whole design: with only an `assets` block, Cloudflare serves
 * dist/ directly and no JavaScript of ours runs per request. That matters beyond tidiness —
 * `_headers` and `_redirects` are applied by the asset server, and Cloudflare explicitly does NOT
 * apply either to responses produced by Worker code. The moment this file grows a `main`, every
 * rule in public/_headers and public/_redirects stops covering whatever that script answers, and
 * has to be reimplemented in it. Don't add one without reading those two files first.
 *
 * Netlify used to serve this, behind Cloudflare's proxy. The zone was already Cloudflare's, so the
 * second CDN was buying a hop and an account rather than a capability. `_headers` and `_redirects`
 * are the same file format here, which is why the migration moved no rules.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korczak-xyz",
  "compatibility_date": "2026-08-30",

  "assets": {
    "directory": "./dist",

    /*
     * Serve dist/404.html, with a 404 status, for anything that matches no asset. The default is
     * `none`, which returns a bare Cloudflare 404 page and would strand src/pages/404.astro.
     */
    "not_found_handling": "404-page"

    /*
     * `html_handling` is left at its "auto-trailing-slash" default on purpose: astro.config.mjs
     * sets `trailingSlash: 'ignore'`, so both /about and /about/ have to reach about/index.html.
     */
  },

  /*
   * A custom domain: Cloudflare owns the apex's DNS record, and there is no origin behind it.
   *
   * It was a route (`korczak.xyz/*`) for the length of the migration, which is worth knowing if
   * you ever have to do this again. A custom domain refuses to attach while a record it does not
   * manage already exists, and during the cutover that record was the CNAME to Netlify — so a
   * route was the way to put the Worker in front of a live origin without touching DNS at all,
   * and to roll back by deleting one line. Once Netlify went, the record was deleted and the
   * custom domain attached in its place.
   *
   * www is NOT here. It 301s to the apex from a zone Single Redirect, which terminates at the
   * edge — a redirect that needs no origin should not cost a Worker invocation. That rule is the
   * one piece of the serving path not in this repo; see CLAUDE.md.
   */
  "routes": [
    { "pattern": "korczak.xyz", "custom_domain": true }
  ],

  /*
   * Explicit because the default flips the moment `routes` exists: adding that key turned
   * workers.dev off in the same deploy, and since the domain had not attached yet, that deploy
   * left the Worker reachable at no hostname at all. Keep it — the preview URL is how a build
   * gets checked before the domain points at it, and public/_headers keeps it out of search.
   */
  "workers_dev": true,

  "observability": { "enabled": true }
}
