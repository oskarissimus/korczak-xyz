# Hashed build assets never change under a given name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Filenames carry the font version and the icons change about never, but neither is
# content-hashed, so neither may be immutable.
/fonts/*
  Cache-Control: public, max-age=31536000
/icons/*
  Cache-Control: public, max-age=604800

# The service worker must never be served from cache. This is the iOS "cache trap": a home
# screen web app holds its assets indefinitely, so a stale worker means the installed app can
# never pick up a new one and goes on running whatever it shipped with, forever.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifests/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

# HTML must revalidate, or a cached page can outlive the chunks it references.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# The Worker also answers on workers.dev, which is a second hostname serving byte-identical pages —
# exactly the duplicate Google would otherwise have to pick a canonical for, possibly wrongly. The
# preview URL is worth keeping (it is how a build gets checked before DNS moves to it), so the fix
# is to tell crawlers rather than to turn it off. Two rules because a version preview URL carries an
# extra leading label; placeholders stop at a dot, so neither pattern covers the other.
https://korczak-xyz.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
https://:version.korczak-xyz.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
