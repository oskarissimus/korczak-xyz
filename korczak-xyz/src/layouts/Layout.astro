---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar/Navbar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n';
import islandRecovery from '../scripts/island-recovery.js?raw';
import registerSw from '../scripts/register-sw.js?raw';
import PwaHead from '../components/PwaHead.astro';
import type { PwaApp } from '../utils/pwa/apps';
import '../styles/global.css';
import '../styles/auth.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /**
   * Which installable web app this page belongs to. iOS reads the manifest linked from the
   * page you install from, so this decides whether "Add to Home Screen" here produces one of
   * the scoped apps or the whole site. Every page of a scoped app has to set it — a tab that
   * forgets installs the site under the app's own name.
   */
  pwa?: PwaApp;
}

const {
  title = 'korczak.xyz',
  description = 'Personal website of Oskar Korczak',
  lang = 'en',
  pwa = 'site'
} = Astro.props;

const currentPath = Astro.url.pathname;

const t = useTranslations(lang);
const recoveryStrings = {
  title: t('hydrationError.title'),
  message: t('hydrationError.message'),
  reload: t('hydrationError.reload'),
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover is what makes env(safe-area-inset-*) return anything but zero; the
         --safe-* insets further down are built on it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover" />
    <!-- Nothing on the site is meant to be dialled or mailed, so keep mobile browsers from
         turning phone-number- or email-shaped text into links of their own accord. -->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <meta name="description" content={description} />
    <meta name="image" content="https://korczak.xyz/logo.png" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <PwaHead app={pwa} lang={lang} />
    <title>{title}</title>
    <!-- The fonts are served from this origin (see public/fonts/README.md); preloading the two
         latin subsets keeps first paint as fast as the old render-blocking Google stylesheet. -->
    <link rel="preload" href="/fonts/vt323-v18-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/press-start-2p-v16-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ recoveryStrings }}>
      window.__islandRecoveryI18n = recoveryStrings;
    </script>
    <script is:inline set:html={islandRecovery}></script>
    <script is:inline set:html={registerSw}></script>
    <!-- Client-side routing. The point is the navbar: without it every click tears the
         document down, and the auth islands - the only part of the menu that is not
         server-rendered - have to resolve Firebase's session again from scratch, which is
         what made the email blink. See transition:persist in Navbar.astro. -->
    <ClientRouter />
  </head>
  <body>
    <!-- SVG filter for Win95 dithered 16-color effect -->
    <svg style="position: absolute; width: 0; height: 0;">
      <defs>
        <!-- Dither pattern -->
        <filter id="dither-pattern" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="1.5" numOctaves="1" result="noise"/>
          <feComponentTransfer result="threshold">
            <feFuncR type="discrete" tableValues="0 1"/>
            <feFuncG type="discrete" tableValues="0 1"/>
            <feFuncB type="discrete" tableValues="0 1"/>
          </feComponentTransfer>
        </filter>

        <!-- Combined dither + posterize filter -->
        <filter id="win95-dithered" x="0" y="0" width="100%" height="100%">
          <!-- Add noise before posterizing to create dither effect -->
          <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="1" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced"/>

          <!-- Blend noise with image for dithering -->
          <feBlend in="SourceGraphic" in2="noise" mode="overlay" result="dithered"/>

          <!-- Posterize to 64 colors (4 levels per channel = 4x4x4 = 64) -->
          <feComponentTransfer in="dithered">
            <feFuncR type="discrete" tableValues="0 0.33 0.67 1"/>
            <feFuncG type="discrete" tableValues="0 0.33 0.67 1"/>
            <feFuncB type="discrete" tableValues="0 0.33 0.67 1"/>
          </feComponentTransfer>

          <!-- Boost contrast -->
          <feComponentTransfer>
            <feFuncR type="linear" slope="1.15" intercept="-0.075"/>
            <feFuncG type="linear" slope="1.15" intercept="-0.075"/>
            <feFuncB type="linear" slope="1.15" intercept="-0.075"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <div class="container">
      <Navbar lang={lang} currentPath={currentPath} />
      <slot />
      <Footer lang={lang} />
    </div>
    <div class="taskbar">
      <div class="taskbar-items"></div>
    </div>
    <script>
      /*
       * Keep "Add to Home Screen" honest across client-side navigations.
       *
       * Safari binds the manifest, the title and the touch icon when a document loads and
       * never re-reads them. ClientRouter swaps all three correctly in the DOM - that much is
       * verified - but Safari goes on offering whatever it captured at the last full load, so
       * clicking through the site to the tuner produced an install dialog carrying the
       * songbook's name and start URL under the tuner's icon.
       *
       * So a navigation that changes which manifest the page links is made a real page load.
       * Everything within one app and locale stays a soft navigation, which is the case that
       * matters: clicking through the songbook.
       */
      import { crossesAppBoundary } from '../utils/pwa/scope';

      declare global {
        interface Window {
          __pwaBoundary?: { from: string };
        }
      }

      // Astro re-runs module scripts after every swap; the listeners belong to the document,
      // which outlives them.
      if (!window.__pwaBoundary) {
        window.__pwaBoundary = { from: location.pathname };

        document.addEventListener(
          'click',
          (event) => {
            const link = (event.target as Element | null)?.closest?.('a[href]');
            if (!(link instanceof HTMLAnchorElement)) return;
            if (link.origin !== location.origin || link.hasAttribute('download')) return;
            if (!crossesAppBoundary(location.pathname, link.pathname)) return;
            // Read by ClientRouter's own click handler, which runs after this capture pass.
            link.dataset.astroReload = '';
          },
          { capture: true },
        );

        /*
         * Back/forward and any other soft navigation the click handler never saw. Costs a
         * reload after the swap, which is worse than not needing one and much better than an
         * install dialog describing a different app. It cannot loop: the reload is a real page
         * load, so the next run of this script starts from the destination.
         */
        document.addEventListener('astro:page-load', () => {
          const boundary = window.__pwaBoundary;
          if (boundary && crossesAppBoundary(boundary.from, location.pathname)) location.reload();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Self-hosted rather than loaded from fonts.gstatic.com, because an installed web app has to
     render with no network and because song.css aligns chords over lyrics by character cell -
     a system-font fallback misaligns every chord chart. See public/fonts/README.md.

     The unicode-range split is Google's own: latin-ext carries every Polish diacritic except
     ó, so the /pl locale and the lyrics need it, but English pages never fetch it. */
  @font-face {
    font-family: 'VT323';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/vt323-v18-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'VT323';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/vt323-v18-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
      U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0,
      U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/press-start-2p-v16-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/press-start-2p-v16-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
      U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0,
      U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* No cross-fade between pages. A 90s desktop redraws instantly or not at all, and the
     default fade only draws attention to a swap that should go unnoticed. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  :root {
    --retro-navy: #000080;
    --retro-teal: #008080;
    --retro-yellow: #ffff00;
    --retro-cyan: #00ffff;
    --retro-magenta: #ff00ff;
    --retro-gray: #c0c0c0;
    --retro-dark-gray: #808080;
    --retro-white: #ffffff;
    --retro-black: #000000;
    --retro-green: #00ff00;
    --retro-red: #ff0000;

    /* The safe area, as four named values. env() can only be read where it is written, and the
       one device it is ever non-zero on is the one with no devtools window to open; behind
       custom properties the whole layout can be driven from a desktop console with the insets
       a real phone reports. */
    --safe-top: env(safe-area-inset-top);
    --safe-right: env(safe-area-inset-right);
    --safe-bottom: env(safe-area-inset-bottom);
    --safe-left: env(safe-area-inset-left);
  }

  /* The safe area belongs to the document, not to any one page's layout. On <body> it is one
     `padding: 0` away from being lost - and body padding is zeroed below 600px, which is
     exactly how the installed songbook came to draw its title bar under the clock back when
     song.css was the only thing doing it. Up here a page is free to zero its own padding and
     still cannot walk content into the hardware.

     No display-mode gate: env() is zero wherever browser chrome already reserves the space, so
     this is inert in a tab - except in landscape on a notched phone, where viewport-fit=cover
     does put the page under the camera cutout and nothing was insetting it before.

     No background either: with none set here, body's navy propagates to the canvas and fills
     the padding, so the strip reads as the desktop the windows sit on. */
  html {
    padding-top: var(--safe-top);
    padding-right: var(--safe-right);
    padding-bottom: var(--safe-bottom);
    padding-left: var(--safe-left);
  }

  /* Reserving the strip is only half of it: padding scrolls. It holds the first screen clear
     of the clock and then the page slides straight under it, which is why an installed songbook
     looked fixed until you scrolled - and why a maximized window, being fixed and inset, looked
     fixed all along. So the strip is also painted: a band the page scrolls behind, in the same
     navy as the desktop, sized from the same inset and therefore nothing at all in a browser.

     Above everything, including the taskbar (9999) and the typing modal (10000). The point is
     that the status bar always has an opaque backdrop of a known colour; a band any overlay can
     paint over is a band that does not do its job. */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--safe-top);
    background: var(--retro-navy);
    z-index: 10001;
    pointer-events: none;
  }

  body {
    font-family: 'VT323', monospace;
    /* Minus the insets: the body now sits inside them, and 100dvh would scroll the page by
       their height on content that fits. */
    min-height: calc(100dvh - var(--safe-top) - var(--safe-bottom));
    background: var(--retro-navy);
    color: var(--retro-yellow);
    padding: 20px;
    padding-bottom: 60px;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Window styling */
  .window {
    background: var(--retro-gray);
    border: 3px outset var(--retro-white);
    margin-bottom: 20px;
    position: relative;
  }

  .window.dragging {
    opacity: 0.95;
  }

  .title-bar {
    background: linear-gradient(90deg, var(--retro-navy), #1084d0);
    color: white;
    padding: 4px 8px;
    font-family: 'Press Start 2P', cursive;
    font-size: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: grab;
    user-select: none;
  }

  .title-bar:active {
    cursor: grabbing;
  }

  .title-buttons {
    display: flex;
    gap: 4px;
  }

  .title-btn {
    width: 16px;
    height: 14px;
    background: var(--retro-gray);
    border: 2px outset var(--retro-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center;
  }

  .title-btn:hover {
    background-color: #a0a0a0;
  }

  .title-btn:active {
    border-style: inset;
  }

  /* Window control button icons */
  .minimize-btn {
    background-image: url("data:image/svg+xml,%3Csvg width='8' height='2' viewBox='0 0 8 2' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='8' height='2' fill='black'/%3E%3C/svg%3E");
    background-position: center bottom 1px;
  }

  .maximize-btn {
    background-image: url("data:image/svg+xml,%3Csvg width='9' height='9' viewBox='0 0 9 9' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M9 0H0V2V8V9H1H8H9V8V2V0ZM8 2H1V8H8V2Z' fill='black'/%3E%3C/svg%3E");
    background-position: center;
  }

  .close-btn {
    background-image: url("data:image/svg+xml,%3Csvg width='8' height='7' viewBox='0 0 8 7' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M0 0H1H2V1H3V2H4H5V1H6V0H7H8V1H7V2H6V3H5V4H6V5H7V6H8V7H7H6V6H5V5H4H3V6H2V7H1H0V6H1V5H2V4H3V3H2V2H1V1H0V0Z' fill='black'/%3E%3C/svg%3E");
    background-position: center;
  }

  .window-content {
    padding: 20px;
    background: var(--retro-teal);
    color: var(--retro-white);
  }

  /* Links */
  a {
    color: var(--retro-cyan);
    text-decoration: underline;
  }

  a:hover {
    color: var(--retro-yellow);
  }

  a:visited {
    color: var(--retro-magenta);
  }

  /* Retro buttons */
  .retro-btn {
    background: var(--retro-gray);
    border: 3px outset var(--retro-white);
    padding: 10px 20px;
    font-family: 'VT323', monospace;
    font-size: 1.2rem;
    color: var(--retro-black);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .retro-btn:hover {
    background: #a0a0a0;
    color: var(--retro-black);
  }

  .retro-btn:active {
    border-style: inset;
  }

  /* Animations */
  @keyframes rainbow {
    0% { color: #ff0000; }
    16% { color: #ff8800; }
    33% { color: #ffff00; }
    50% { color: #00ff00; }
    66% { color: #0088ff; }
    83% { color: #ff00ff; }
    100% { color: #ff0000; }
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }

  .rainbow-text {
    animation: rainbow 3s infinite;
  }

  .blink {
    animation: blink 1s infinite;
  }

  /* Visitor counter style */
  .visitor-counter {
    background: var(--retro-black);
    display: inline-block;
    padding: 5px 15px;
    border: 2px inset var(--retro-dark-gray);
  }

  .visitor-counter span {
    font-family: 'VT323', monospace;
    color: var(--retro-green);
    font-size: 1.2rem;
  }

  /* Marquee */
  .marquee-container {
    background: var(--retro-black);
    /* No horizontal padding: `padding-left: 100%` below resolves against this content box,
       while `overflow: hidden` clips at the padding box. Any gap between the two edges shows
       a sliver of a glyph popping in at the start of each pass and vanishing early at the end. */
    padding: 10px 0;
    overflow: hidden;
    border: 2px inset var(--retro-dark-gray);
  }

  /* The text has to clear the container completely before the pass restarts, so the animation
     must travel `container + text`. As a block box that is impossible to express: the box is as
     wide as the container, `nowrap` text overflows it without widening it, and -100% falls short
     by the length of the overflow. Shrink-to-fit makes 100% the text's own width, and the
     padding parks it off the right edge to begin with. */
  .marquee-text {
    display: inline-block;
    padding-left: 100%;
    white-space: nowrap;
    /* 28s, not the old 15s: the pass now covers `container + text` (~3100px at the 900px cap)
       rather than twice the container (~1670px), so the old duration would run it half again
       as fast. This keeps the original ~111px/s. */
    animation: marquee 28s linear infinite;
    color: var(--retro-green);
    font-size: 1.3rem;
  }

  /* Under construction */
  /* Deliberately `nowrap`: the two signs flank the text, so wrapping is the wrong axis to give
     way on. With `wrap`, a phone-width line put `gif + text` on one row and left the second gif
     stranded on a row of its own, centred under a caption it was supposed to be beside. The
     text is the part that can take two lines, so it is the part that gives - it shrinks and
     wraps between the signs, down to its longest word.

     The horizontal padding is for the spin: the signs are 40px squares rotating about their
     centres, and a transform does not widen the layout box, so at 45deg each corner sweeps
     ~8px past it. Below 600px the body goes full bleed, and without this the leading sign
     scrapes the edge of the screen twice a second. */
  .under-construction {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 0 10px;
  }

  .construction-gif {
    flex: none;
    width: 40px;
    height: 40px;
    background: repeating-linear-gradient(
      45deg,
      var(--retro-yellow),
      var(--retro-yellow) 10px,
      var(--retro-black) 10px,
      var(--retro-black) 20px
    );
    animation: spin 2s linear infinite;
  }

  @keyframes spin {
    100% { transform: rotate(360deg); }
  }

  /* Images - Win95 16-color style with dithering */
  img {
    max-width: 100%;
    height: auto;
    border: none;
    image-rendering: pixelated;
    filter: url(#win95-dithered);
  }

  /* Lists */
  ul, ol {
    margin-left: 20px;
    margin-bottom: 15px;
  }

  li {
    margin-bottom: 5px;
  }

  /* Headings */
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Press Start 2P', cursive;
    margin-bottom: 15px;
    line-height: 1.5;
  }

  h1 {
    font-size: clamp(0.8rem, 3vw, 1.2rem);
    color: var(--retro-yellow);
    text-shadow: 3px 3px var(--retro-magenta);
  }

  h2 {
    font-size: clamp(0.7rem, 2.5vw, 1rem);
    color: var(--retro-cyan);
  }

  h3 {
    font-size: clamp(0.6rem, 2vw, 0.9rem);
    color: var(--retro-green);
  }

  /* Paragraphs */
  p {
    margin-bottom: 15px;
  }

  /* Code */
  code {
    background: var(--retro-black);
    color: var(--retro-green);
    padding: 2px 6px;
    font-family: 'VT323', monospace;
    border: 1px inset var(--retro-dark-gray);
  }

  pre {
    background: var(--retro-black);
    color: var(--retro-green);
    padding: 15px;
    overflow-x: auto;
    border: 2px inset var(--retro-dark-gray);
    margin-bottom: 15px;
  }

  pre code {
    border: none;
    padding: 0;
  }

  /* Form elements */
  input, textarea, select {
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    background: var(--retro-white);
    border: 2px inset var(--retro-dark-gray);
    padding: 8px;
    color: var(--retro-black);
  }

  input:focus, textarea:focus, select:focus {
    outline: 2px solid var(--retro-cyan);
  }

  button {
    font-family: 'VT323', monospace;
    font-size: 1.1rem;
    background: var(--retro-gray);
    border: 3px outset var(--retro-white);
    padding: 8px 16px;
    cursor: pointer;
    color: var(--retro-black);
  }

  button:hover {
    background: #a0a0a0;
  }

  button:active {
    border-style: inset;
  }

  /* Responsive */
  @media (max-width: 600px) {
    /* Full bleed. A phone has no room to spend on a decorative gutter, and a window frame
       stopping 10px short of the screen edge only reads as a margin, not as a desktop. The
       song page has been doing this for its own layout; this is that, for every page.

       padding-bottom, not the shorthand alone: the shorthand takes the base rule's 60px with
       it, and the fixed .taskbar is 40px tall. 50px is what song.css already used. */
    body {
      padding: 0;
      padding-bottom: 50px;
      font-size: 1.1rem;
    }

    .window-content {
      padding: 15px;
    }

    h1 {
      font-size: 0.7rem;
    }
  }

  /* Launched from the home screen: no browser chrome, so the page owns the whole display.
     Getting out of the way of the hardware is not in here - the --safe-* insets do that
     everywhere, since they are zero wherever there is chrome to reserve the space. What is
     left is behaviour that only makes sense once there is no browser around the page. */
  @media (display-mode: standalone) {
    body {
      /* Rubber-band scrolling reads as a bug once there is no browser to pull against. */
      overscroll-behavior-y: none;
    }

    /* Long-pressing the window chrome should not offer to copy it. Lyrics and prose stay
       selectable - being able to lift a verse out of a song page is worth keeping. */
    .title-bar,
    .taskbar,
    button {
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }
  }

  /* Taskbar. Fixed to the viewport, so the padding on <html> does not reach it and it carries
     its own insets - the home indicator sits exactly where it lives. */
  .taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: calc(40px + var(--safe-bottom));
    background: var(--retro-gray);
    border-top: 3px outset var(--retro-white);
    display: flex;
    align-items: center;
    padding: 4px calc(8px + var(--safe-right)) calc(4px + var(--safe-bottom))
      calc(8px + var(--safe-left));
    z-index: 9999;
  }

  .taskbar-items {
    display: flex;
    gap: 4px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .taskbar-item {
    background: var(--retro-gray);
    border: 2px outset var(--retro-white);
    padding: 4px 12px;
    font-family: 'Press Start 2P', cursive;
    font-size: 8px;
    cursor: pointer;
    white-space: nowrap;
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--retro-black);
  }

  .taskbar-item:hover {
    background: #a0a0a0;
  }

  .taskbar-item:active {
    border-style: inset;
  }

  .taskbar:empty,
  .taskbar-items:empty {
    display: none;
  }

  /* Maximized window. Fixed too, so like the taskbar it insets itself; without this its title
     bar - and the button you press to restore it - lands under the status bar. It is
     positioned on both edges, so width is auto rather than 100%, which would overflow by the
     side insets. */
  .window.maximized {
    position: fixed !important;
    top: var(--safe-top) !important;
    left: var(--safe-left) !important;
    right: var(--safe-right) !important;
    bottom: var(--safe-bottom) !important;
    width: auto !important;
    /* dvh, not vh: with no browser chrome the visual viewport is what matters, and vh keeps
       counting a URL bar that is not there. */
    height: calc(100dvh - var(--safe-top) - var(--safe-bottom)) !important;
    transform: none !important;
    margin: 0 !important;
    z-index: 9998 !important;
    max-width: none !important;
  }

  /* Adjust for taskbar when visible */
  body.taskbar-visible .window.maximized {
    bottom: calc(40px + var(--safe-bottom)) !important;
    height: calc(100dvh - var(--safe-top) - 40px - var(--safe-bottom)) !important;
  }

  .window.maximized .window-content {
    height: calc(100% - 28px);
    overflow: auto;
  }

  /* Restore button icon (two overlapping squares) */
  .maximize-btn.restore {
    background-image: url("data:image/svg+xml,%3Csvg width='8' height='9' viewBox='0 0 8 9' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='2' width='6' height='2' fill='black'/%3E%3Crect x='7' y='2' width='1' height='4' fill='black'/%3E%3Crect x='2' y='2' width='1' height='1' fill='black'/%3E%3Crect x='6' y='5' width='1' height='1' fill='black'/%3E%3Crect y='3' width='6' height='2' fill='black'/%3E%3Crect x='5' y='5' width='1' height='4' fill='black'/%3E%3Crect y='5' width='1' height='4' fill='black'/%3E%3Crect x='1' y='8' width='4' height='1' fill='black'/%3E%3C/svg%3E");
    background-position: center;
  }
</style>

<script>
  // Track minimized windows
  const minimizedWindows = new Map<string, HTMLElement>();
  let windowIdCounter = 0;

  // Track maximized windows and their previous state
  interface WindowState {
    transform: string;
    width: string;
    height: string;
    position: string;
  }
  const maximizedWindows = new Map<string, WindowState>();

  // Get or create unique ID for a window
  function getWindowId(win: HTMLElement): string {
    if (!win.dataset.windowId) {
      win.dataset.windowId = `window-${windowIdCounter++}`;
    }
    return win.dataset.windowId;
  }

  // Get window title from title bar
  function getWindowTitle(win: HTMLElement): string {
    const titleBar = win.querySelector('.title-bar');
    const titleSpan = titleBar?.querySelector('span');
    return titleSpan?.textContent || 'Window';
  }

  // Minimize a window
  function minimizeWindow(win: HTMLElement) {
    const windowId = getWindowId(win);
    const title = getWindowTitle(win);

    // Hide the window but preserve space
    win.style.visibility = 'hidden';
    win.style.pointerEvents = 'none';
    win.style.opacity = '0';

    // Store reference
    minimizedWindows.set(windowId, win);

    // Add to taskbar
    const taskbarItems = document.querySelector('.taskbar-items');
    if (taskbarItems) {
      const item = document.createElement('div');
      item.className = 'taskbar-item';
      item.dataset.windowId = windowId;
      item.textContent = title;
      item.title = title;
      taskbarItems.appendChild(item);
    }

    // Show taskbar if it has items
    updateTaskbarVisibility();
  }

  // Restore a window from taskbar
  function restoreWindow(windowId: string) {
    const win = minimizedWindows.get(windowId);
    if (win) {
      // Show the window
      win.style.visibility = '';
      win.style.pointerEvents = '';
      win.style.opacity = '';
      bringToFront(win);

      // Remove from tracking
      minimizedWindows.delete(windowId);

      // Remove from taskbar
      const taskbarItem = document.querySelector(`.taskbar-item[data-window-id="${windowId}"]`);
      taskbarItem?.remove();

      // Update taskbar visibility
      updateTaskbarVisibility();
    }
  }

  // Update taskbar visibility based on items
  function updateTaskbarVisibility() {
    const taskbar = document.querySelector('.taskbar') as HTMLElement;
    const taskbarItems = document.querySelector('.taskbar-items');
    if (taskbar && taskbarItems) {
      const hasItems = taskbarItems.children.length > 0;
      taskbar.style.display = hasItems ? 'flex' : 'none';
      document.body.classList.toggle('taskbar-visible', hasItems);
    }
  }

  // Maximize a window
  function maximizeWindow(win: HTMLElement) {
    const windowId = getWindowId(win);
    const maximizeBtn = win.querySelector('.maximize-btn');

    // Store current state before maximizing
    maximizedWindows.set(windowId, {
      transform: win.style.transform || '',
      width: win.style.width || '',
      height: win.style.height || '',
      position: win.style.position || ''
    });

    // Apply maximized class (CSS handles the rest)
    win.classList.add('maximized');
    bringToFront(win);

    // Update button to show restore icon
    if (maximizeBtn) {
      maximizeBtn.classList.add('restore');
    }
  }

  // Restore a maximized window
  function restoreFromMaximize(win: HTMLElement) {
    const windowId = getWindowId(win);
    const maximizeBtn = win.querySelector('.maximize-btn');
    const previousState = maximizedWindows.get(windowId);

    // Remove maximized class
    win.classList.remove('maximized');

    // Restore previous state
    if (previousState) {
      win.style.transform = previousState.transform;
      win.style.width = previousState.width;
      win.style.height = previousState.height;
      win.style.position = previousState.position;
    }

    // Remove from tracking
    maximizedWindows.delete(windowId);

    // Update button to show maximize icon
    if (maximizeBtn) {
      maximizeBtn.classList.remove('restore');
    }
  }

  // Initialize taskbar visibility
  updateTaskbarVisibility();

  // Everything below is delegated on `document`, which survives a client-side navigation,
  // so the handlers keep working without being re-registered. What does not survive is the
  // page's windows: the maps above would otherwise hold on to elements that no longer
  // exist, and a window minimized on the previous page would leave a taskbar button
  // pointing at nothing. The taskbar markup itself comes back empty with the new page.
  document.addEventListener('astro:after-swap', () => {
    minimizedWindows.clear();
    maximizedWindows.clear();
    updateTaskbarVisibility();
  });

  // Close button functionality
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('close-btn')) {
      const win = target.closest('.window');
      if (win) {
        const windowId = getWindowId(win as HTMLElement);
        // Remove from minimized if it was minimized
        minimizedWindows.delete(windowId);
        const taskbarItem = document.querySelector(`.taskbar-item[data-window-id="${windowId}"]`);
        taskbarItem?.remove();
        updateTaskbarVisibility();
        // Hide but preserve space
        (win as HTMLElement).style.visibility = 'hidden';
        (win as HTMLElement).style.pointerEvents = 'none';
        (win as HTMLElement).style.opacity = '0';
      }
    }
  });

  // Minimize button functionality
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('minimize-btn')) {
      const win = target.closest('.window') as HTMLElement;
      if (win) {
        minimizeWindow(win);
      }
    }
  });

  // Maximize button functionality
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('maximize-btn')) {
      const win = target.closest('.window') as HTMLElement;
      if (win) {
        const windowId = getWindowId(win);
        if (maximizedWindows.has(windowId)) {
          restoreFromMaximize(win);
        } else {
          maximizeWindow(win);
        }
      }
    }
  });

  // Taskbar item click to restore window
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('taskbar-item')) {
      const windowId = target.dataset.windowId;
      if (windowId) {
        restoreWindow(windowId);
      }
    }
  });

  // Double-click on title bar to maximize/restore
  document.addEventListener('dblclick', (e) => {
    const target = e.target as HTMLElement;
    // Only trigger on title-bar itself or its text span (not buttons)
    if (target.classList.contains('title-bar') ||
        (target.closest('.title-bar') && !target.closest('.title-buttons'))) {
      const titleBar = target.classList.contains('title-bar') ? target : target.closest('.title-bar');
      const win = titleBar?.closest('.window') as HTMLElement;
      if (win) {
        const windowId = getWindowId(win);
        if (maximizedWindows.has(windowId)) {
          restoreFromMaximize(win);
        } else {
          maximizeWindow(win);
        }
      }
    }
  });

  // Draggable windows
  let draggedWindow: HTMLElement | null = null;
  let startX = 0;
  let startY = 0;
  let currentTranslateX = 0;
  let currentTranslateY = 0;
  let highestZIndex = 100;

  function getTranslateValues(element: HTMLElement) {
    const transform = element.style.transform;
    if (!transform || transform === 'none') {
      return { x: 0, y: 0 };
    }
    const match = transform.match(/translate\((-?\d+(?:\.\d+)?px),\s*(-?\d+(?:\.\d+)?px)\)/);
    if (match) {
      return { x: parseFloat(match[1]), y: parseFloat(match[2]) };
    }
    return { x: 0, y: 0 };
  }

  function bringToFront(win: HTMLElement) {
    highestZIndex++;
    win.style.zIndex = String(highestZIndex);
  }

  document.addEventListener('mousedown', (e) => {
    const target = e.target as HTMLElement;

    // Only start drag if clicking on title-bar (not buttons)
    if (target.classList.contains('title-bar') ||
        (target.closest('.title-bar') && !target.closest('.title-buttons'))) {
      const titleBar = target.classList.contains('title-bar') ? target : target.closest('.title-bar');
      const win = titleBar?.closest('.window') as HTMLElement;

      if (win) {
        draggedWindow = win;
        draggedWindow.classList.add('dragging');
        bringToFront(win);

        const translate = getTranslateValues(win);
        currentTranslateX = translate.x;
        currentTranslateY = translate.y;
        startX = e.clientX;
        startY = e.clientY;

        e.preventDefault();
      }
    }
  });

  document.addEventListener('mousemove', (e) => {
    if (draggedWindow) {
      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      draggedWindow.style.transform = `translate(${currentTranslateX + deltaX}px, ${currentTranslateY + deltaY}px)`;
    }
  });

  document.addEventListener('mouseup', () => {
    if (draggedWindow) {
      draggedWindow.classList.remove('dragging');
      draggedWindow = null;
    }
  });
</script>
