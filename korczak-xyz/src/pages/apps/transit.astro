---
import Layout from '../../layouts/Layout.astro';
import TransitFeed from '../../components/Transit/TransitFeed';
import TransitTabs from '../../components/Transit/TransitTabs.astro';
import TransitFeedSkeleton from '../../components/Transit/skeletons/TransitFeedSkeleton.astro';
import { useTranslations } from '../../i18n';
import '../../styles/transit.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`${t('Transit')} | korczak.xyz`} lang={lang} pwa="transit">
  <div class="window transit-window">
    <div class="title-bar">
      <span>{t('Transit')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content transit-content">
      <TransitTabs lang={lang} active="feed" />
      <TransitFeed client:only="react" lang={lang}>
        <TransitFeedSkeleton slot="fallback" lang={lang} />
      </TransitFeed>
    </div>
  </div>
</Layout>
