---
import Layout from '../../layouts/Layout.astro';
import PageContent from '../../components/PageContent.astro';
import AdminAppCard from '../../components/Auth/AdminAppCard';
import { useTranslations } from '../../i18n';
import '../../styles/appsList.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`${t('Apps')} | korczak.xyz`} lang={lang}>
  <PageContent title={t('Apps')}>
    <ul class="apps-list">
      <li>
        <a href="/apps/typing/" class="app-link">
          <span class="app-icon">{'⌨'}</span>
          <span class="app-info">
            <span class="app-title">{t('Typing')}</span>
            <span class="app-desc">{t('typing.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/flashcards/" class="app-link">
          <span class="app-icon">{'\u{1F3BC}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Flashcards')}</span>
            <span class="app-desc">{t('flashcards.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/solitaire/" class="app-link">
          <span class="app-icon">♠</span>
          <span class="app-info">
            <span class="app-title">{t('Solitaire')}</span>
            <span class="app-desc">Klondike</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/minesweeper/" class="app-link">
          <span class="app-icon">{'\u{1F4A3}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Minesweeper')}</span>
            <span class="app-desc">{t('minesweeper.classicPuzzle')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/pipes/" class="app-link">
          <span class="app-icon">{'\u{1FAA0}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Pipes')}</span>
            <span class="app-desc">{t('pipes.screensaver')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/tuner/" class="app-link">
          <span class="app-icon">{'\u{1F3B8}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Tuner')}</span>
            <span class="app-desc">{t('tuner.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/anesthesia/" class="app-link">
          <span class="app-icon">{'\u{1FA7A}'}</span>
          <span class="app-info">
            <span class="app-title">{t('AnesthesiaQuiz')}</span>
            <span class="app-desc">{t('anesthesia.quizDesc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/events/" class="app-link">
          <span class="app-icon">{'\u{1F3AB}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Events')}</span>
            <span class="app-desc">{t('events.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/transit/" class="app-link">
          <span class="app-icon">{'\u{1F687}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Transit')}</span>
            <span class="app-desc">{t('transit.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/baby-sleep/" class="app-link">
          <span class="app-icon">{'\u{1F319}'}</span>
          <span class="app-info">
            <span class="app-title">{t('BabySleep')}</span>
            <span class="app-desc">{t('babySleep.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/shopping/" class="app-link">
          <span class="app-icon">{'\u{1F6D2}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Shopping')}</span>
            <span class="app-desc">{t('shopping.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/pregnancy-calendar/" class="app-link">
          <span class="app-icon">{'\u{1F930}'}</span>
          <span class="app-info">
            <span class="app-title">{t('PregnancyCalendar')}</span>
            <span class="app-desc">{t('pregnancy.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/sloper/" class="app-link">
          <span class="app-icon">{'\u{1F3AC}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Sloper')}</span>
            <span class="app-desc">{t('sloper.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/backseat/" class="app-link">
          <span class="app-icon">{'\u{1F5E3}'}</span>
          <span class="app-info">
            <span class="app-title">{t('Backseat')}</span>
            <span class="app-desc">{t('backseat.desc')}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/apps/audio-guide/" class="app-link">
          <span class="app-icon">{'\u{1F5FA}'}</span>
          <span class="app-info">
            <span class="app-title">{t('AudioGuide')}</span>
            <span class="app-desc">{t('audioGuide.desc')}</span>
          </span>
        </a>
      </li>
      <AdminAppCard client:only="react" lang={lang} />
    </ul>
  </PageContent>
</Layout>
