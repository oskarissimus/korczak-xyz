---
import Layout from '../../layouts/Layout.astro';
import Rpg from '../../components/Rpg/Rpg';
import { useTranslations } from '../../i18n';
import '../../styles/rpg.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`${t('Rpg')} | korczak.xyz`} description={t('rpg.desc')} lang={lang}>
  <div class="window rpg-window">
    <div class="title-bar">
      <span>{t('Rpg')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content rpg-content">
      <Rpg client:only="react" lang={lang} />
    </div>
  </div>
</Layout>
