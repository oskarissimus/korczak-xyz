---
import Layout from '../../layouts/Layout.astro';
import Typing from '../../components/Typing/Typing';
import TypingSkeleton from '../../components/Typing/skeletons/TypingSkeleton.astro';
import TypingTabs from '../../components/Typing/TypingTabs.astro';
import { useTranslations } from '../../i18n';
import '../../styles/typing.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`${t('Typing')} | korczak.xyz`} lang={lang}>
  <div class="window typing-window">
    <div class="title-bar">
      <span>{t('Typing')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content typing-content">
      <TypingTabs lang={lang} active="practice" />
      <Typing client:only="react" lang={lang}>
        <TypingSkeleton slot="fallback" lang={lang} />
      </Typing>
    </div>
  </div>
</Layout>
