---
import Layout from '../../../layouts/Layout.astro';
import TypingStats from '../../../components/Typing/TypingStats';
import StatsSkeleton from '../../../components/Typing/skeletons/StatsSkeleton.astro';
import TypingTabs from '../../../components/Typing/TypingTabs.astro';
import { useTranslations } from '../../../i18n';
import '../../../styles/typing.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`${t('TypingStats')} | korczak.xyz`} lang={lang}>
  <div class="window typing-window">
    <div class="title-bar">
      <span>{t('TypingStats')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content typing-content">
      <TypingTabs lang={lang} active="progress" />
      <TypingStats client:only="react" lang={lang}>
        <StatsSkeleton slot="fallback" lang={lang} />
      </TypingStats>
    </div>
  </div>
</Layout>
