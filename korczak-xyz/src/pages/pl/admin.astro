---
import Layout from '../../layouts/Layout.astro';
import PageContent from '../../components/PageContent.astro';
import AdminAccounts from '../../components/Auth/AdminAccounts';
import { useTranslations } from '../../i18n';

const lang = 'pl';
const t = useTranslations(lang);
---

<Layout title={`${t('auth.accounts')} | korczak.xyz`} lang={lang}>
  <PageContent title={t('auth.accounts')}>
    <AdminAccounts client:only="react" lang={lang} />
  </PageContent>
</Layout>
