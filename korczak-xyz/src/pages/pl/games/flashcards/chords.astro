---
import Layout from '../../../../layouts/Layout.astro';
import TransposeStats from '../../../../components/Transpose/TransposeStats';
import FlashcardsTabs from '../../../../components/Flashcards/FlashcardsTabs.astro';
import { songLibrary } from '../../../../utils/transpose/collect';
import { useTranslations } from '../../../../i18n';
import '../../../../styles/flashcards.css';

const lang = 'pl';
const t = useTranslations(lang);

// Read at build time and handed to the island as a prop, so the song texts never ship.
const library = await songLibrary();
---

<Layout title={`${t('Flashcards')} | korczak.xyz`} lang={lang} pwa="flashcards">
  <div class="window flashcards-window">
    <div class="title-bar">
      <span>{t('Flashcards')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content flashcards-content">
      <FlashcardsTabs lang={lang} active="chords" />
      <TransposeStats client:only="react" lang={lang} library={library} />
    </div>
  </div>
</Layout>
