---
import Layout from '../../../../layouts/Layout.astro';
import BabySleepClimate from '../../../../components/BabySleep/BabySleepClimate';
import BabySleepTabs from '../../../../components/BabySleep/BabySleepTabs.astro';
import BabySleepClimateSkeleton from '../../../../components/BabySleep/skeletons/BabySleepClimateSkeleton.astro';
import { useTranslations } from '../../../../i18n';
import '../../../../styles/babySleep.css';

const lang = 'pl';
const t = useTranslations(lang);
---

<Layout title={`${t('BabySleep')} | korczak.xyz`} lang={lang} pwa="baby-sleep">
  <div class="window baby-sleep-window">
    <div class="title-bar">
      <span>{t('BabySleep')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content baby-sleep-content">
      <BabySleepTabs lang={lang} active="climate" />
      <BabySleepClimate client:only="react" lang={lang}>
        <BabySleepClimateSkeleton slot="fallback" lang={lang} />
      </BabySleepClimate>
    </div>
  </div>
</Layout>
