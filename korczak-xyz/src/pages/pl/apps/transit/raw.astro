---
import Layout from '../../../../layouts/Layout.astro';
import TransitRaw from '../../../../components/Transit/TransitRaw';
import TransitTabs from '../../../../components/Transit/TransitTabs.astro';
import TransitRawSkeleton from '../../../../components/Transit/skeletons/TransitRawSkeleton.astro';
import { useTranslations } from '../../../../i18n';
import '../../../../styles/transit.css';

const lang = 'pl';
const t = useTranslations(lang);
---

<Layout title={`${t('Transit')} | korczak.xyz`} lang={lang} pwa="transit">
  <div class="window transit-window">
    <div class="title-bar">
      <span>{t('Transit')}</span>
      <div class="title-buttons">
        <div class="title-btn minimize-btn"></div>
        <div class="title-btn maximize-btn"></div>
        <div class="title-btn close-btn"></div>
      </div>
    </div>
    <div class="window-content transit-content">
      <TransitTabs lang={lang} active="raw" />
      <TransitRaw client:only="react" lang={lang}>
        <TransitRawSkeleton slot="fallback" lang={lang} />
      </TransitRaw>
    </div>
  </div>
</Layout>
