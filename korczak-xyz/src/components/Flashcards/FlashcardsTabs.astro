---
/**
 * Navigation between the app's three views. Server-rendered rather than part of the islands: every
 * island here is client:only, so anything inside one is missing until React hydrates — and the nav is
 * exactly what you want working when hydration is slow or fails.
 *
 * Three tabs and not two, because the two progress pages are two: one sitting mixes both decks, but
 * the neck heatmap and the chord-key table measure different skills over separate histories, and
 * folding them behind one switch would hide half the answer behind a click.
 */
import { translations, type Lang } from './translations';

type View = 'practice' | 'neck' | 'chords';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/apps/flashcards' : '/apps/flashcards';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'practice', href: `${base}/`, label: t.navPractice },
  { view: 'neck', href: `${base}/neck/`, label: t.navNeck },
  { view: 'chords', href: `${base}/chords/`, label: t.navChords },
];
---

<nav class="win-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="win-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
