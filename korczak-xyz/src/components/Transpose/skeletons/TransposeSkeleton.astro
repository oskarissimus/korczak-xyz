---
/**
 * Server-rendered stand-in for <Transpose client:only="react" />, mirroring the start screen:
 * three figure tiles, the start button, and the settings block. Astro swaps it for the real island
 * the moment React hydrates.
 *
 * It stands in for the *start* screen specifically because that is what the island always renders
 * first — a sitting is something you begin, never something the page loads into.
 *
 * The settings rows print the buttons' real labels, from the same constants the panel reads. A
 * count of blank chips is not enough to reserve the right height: what a row costs at 320px is how
 * many lines it wraps onto, and that is set by the width of the text on the buttons. Nothing here
 * is a measurement to keep up to date — the technique `FretboardSkeleton.astro` uses, for the same
 * reason.
 */
import { DIRECTIONS } from '../../../utils/transpose/cards';
import { NOTATIONS, PATTERN_IDS, patternLabel } from '../../../utils/transpose/theory';
import { LENGTH_CHOICES, NEW_CHOICES } from '../SettingsPanel';
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const TILES = [t.due, t.fresh, t.mastered];

const DIRECTION_LABELS = { transpose: t.dirTranspose, degrees: t.dirDegrees, key: t.dirKey };
const NOTATION_SAMPLES = { polish: 'C#·a·H', german: 'Cis·a·H', international: 'C#·Am·B' };

const ROWS: { label: string; choices: (string | number)[] }[] = [
  { label: t.directions, choices: DIRECTIONS.map((d) => DIRECTION_LABELS[d]) },
  { label: t.patterns, choices: PATTERN_IDS.map(patternLabel) },
  { label: t.keysScope, choices: [t.keysAll, t.keysSongbook] },
  { label: t.notations, choices: NOTATIONS.map((n) => NOTATION_SAMPLES[n]) },
  { label: t.sessionLength, choices: LENGTH_CHOICES },
  { label: t.newPerSession, choices: NEW_CHOICES },
];
---

<div class="tp-start" aria-hidden="true">
  <div class="tp-tiles">
    {
      TILES.map((label) => (
        <div class="tp-tile">
          <span class="tp-tile-value tp-skel-value">—</span>
          <span class="tp-tile-label">{label}</span>
        </div>
      ))
    }
  </div>

  <div class="tp-start-actions">
    <span class="tp-btn tp-btn--primary tp-btn--big">{t.start}</span>
  </div>

  <p class="tp-sync tp-sync--quiet">&nbsp;</p>

  <div class="tp-settings">
    <h3 class="tp-subhead">{t.settings}</h3>
    {
      ROWS.map((row) => (
        <div class="tp-setting">
          <span class="tp-setting-label">{row.label}</span>
          <div class="tp-setting-controls">
            {row.choices.map((choice) => (
              <span class="tp-choice">{choice}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* The figures are the one thing the stand-in cannot know. A dash rather than a
     zero: a zero is a claim, and it would be wrong as often as not. */
  .tp-skel-value {
    color: var(--retro-dark-gray);
  }
</style>
