        [
          'Wszystko, co gra generuje, opłaca się dizlem. Nowy świat z pierwszym questem zużywa zwykle 120–180 L, a gra pokazuje szacunek, zanim go zaczniesz.',
          'Ceny są w złotych i zawierają VAT. Płatność przyjmuje Paddle, nasza strona sprzedaży.',
        ],
      ],
    ],
  },
};

const text = (pl ? plText : en)[kind];
const links: [LegalKind | 'rules', string][] = pl
  ? [
      ['terms', 'Regulamin'],
      ['privacy', 'Prywatność'],
      ['refunds', 'Zwroty'],
      ['pricing', 'Cennik'],
      ['rules', 'Zasady treści'],
    ]
  : [
      ['terms', 'Terms'],
      ['privacy', 'Privacy'],
      ['refunds', 'Refunds'],
      ['pricing', 'Pricing'],
      ['rules', 'Content rules'],
    ];
const perL = (litres: number, pln: number) =>
  `${((pln / litres) * 100).toLocaleString(pl ? 'pl-PL' : 'en-GB', { maximumFractionDigits: 1 })} gr / L`;
---

<h1>{text.title}</h1>
<p class="legal-updated">{updated}</p>
{
  kind === 'pricing' && (
    <section class="legal-section">
      <h2>{pl ? 'Pakiety' : 'Packs'}</h2>
      <table class="legal-prices">
        <tbody>
          {CANISTERS.map((c) => (
            <tr>
              <th scope="row">{packNames[c.id]}</th>
              <td>{c.litres} L</td>
              <td>{zl(c.pln)}</td>
              <td class="legal-dim">{perL(c.litres, c.pln)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>{pl ? 'Jednorazowo. Litry z pakietu nie wygasają.' : 'One-off. Litres from a pack do not expire.'}</p>
      <h2>{pl ? 'Dostawa miesięczna' : 'Monthly delivery'}</h2>
      <table class="legal-prices">
        <tbody>
          <tr>
            <th scope="row">{pl ? 'Subskrypcja' : 'Subscription'}</th>
            <td>{SUBSCRIPTION.litres} L</td>
            <td>{pl ? `${zl(SUBSCRIPTION.pln)} / mies.` : `${zl(SUBSCRIPTION.pln)} / month`}</td>
            <td class="legal-dim">{perL(SUBSCRIPTION.litres, SUBSCRIPTION.pln)}</td>
          </tr>
        </tbody>
      </table>
      <p>
        {pl
          ? 'Odnawia się co miesiąc, anulujesz w każdej chwili. Litry są ważne do kolejnej płatności i nie przechodzą na następny miesiąc.'
          : 'Renews monthly, cancel any time. Its litres are valid until the next billing date and do not carry over.'}
      </p>
    </section>
  )
}
{
  text.sections.map(([title, paras]) => (
    <section class="legal-section">
      <h2>{title}</h2>
      {paras.map((p) => (
        <p>{p}</p>
      ))}
    </section>
  ))
}
<footer class="legal-footer">
  <nav>
    {
      links.map(([page, label]) =>
        page === kind ? <span aria-current="page">{label}</span> : <a href={href(page)}>{label}</a>,
      )
    }
  </nav>
  <p>
    Every RPG · {SELLER.name}{SELLER.nip ? ` · NIP ${SELLER.nip}` : ''} · {SELLER.address} ·{' '}
    <a href={`mailto:${mail}`}>{mail}</a>
  </p>
  <p><a href={`${prefix}/`}>← {pl ? 'Wróć do gry' : 'Back to the game'}</a></p>
</footer>
