---
/*
 * Every RPG's terms, privacy policy, refund policy and price list, on everyrpg.korczak.xyz
 * (`src-rpg/pages/{terms,privacy,refunds,pricing}.astro`), written for players and for Paddle's
 * domain review: the seller named, the prices public, a refund policy, how to cancel.
 *
 * Keep them true to the code: the litres and prices come from `utils/rpg/diesel.ts`, what a refund
 * takes back is `debitAdjustment`, what a subscription's end takes away is `endSubscription`
 * (`functions/src/rpg/wallet.ts`). Who sells is `utils/rpg/seller.ts`, with its correspondence address
 * (see there).
 */
import type { Lang } from '../../i18n';
import { CANISTERS, SUBSCRIPTION } from '../../utils/rpg/diesel';
import { SELLER } from '../../utils/rpg/seller';

export type LegalKind = 'terms' | 'privacy' | 'refunds' | 'pricing';

interface Props {
  kind: LegalKind;
  lang: Lang;
}

const { kind, lang } = Astro.props;
const pl = lang === 'pl';
const prefix = pl ? '/pl' : '';
const href = (page: string) => `${prefix}/${page}/`;
const nip = SELLER.nip ? (pl ? `, NIP ${SELLER.nip}` : `, tax ID (NIP) ${SELLER.nip}`) : '';
const who = pl
  ? `${SELLER.name}, jednoosobowa działalność gospodarcza${nip}, adres do korespondencji: ${SELLER.address}`
  : `${SELLER.name}, a sole trader registered in Poland${nip}, correspondence address: ${SELLER.address}, Poland`;
const mail = SELLER.email;
const zl = (n: number) => `${n} zł`;
const packNames = pl
  ? { can: 'Kanister', barrel: 'Beczka', tank: 'Cysterna' }
  : { can: 'Canister', barrel: 'Barrel', tank: 'Tanker' };

type Section = [string, string[]];

const updated = pl ? 'Ostatnia aktualizacja: 18 listopada 2026' : 'Last updated: 18 November 2026';

