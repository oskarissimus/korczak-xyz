---
/**
 * Server-rendered stand-in for <Sloper client:only="react" />: the step strip and the shape of the
 * settings sheet under it. Astro swaps it for the real island the moment React hydrates.
 *
 * It commits to no *values*, and it cannot: every one of them is in localStorage or in Firestore,
 * and this runs at build time. Nothing here may import `storage.ts` for that reason. The point is
 * only that the window is the right height and the strip does not jump — a page that renders
 * empty and then grows by 600px is the thing this avoids.
 */
import { translations, type Lang } from './translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const steps = [t.stepConfig, t.stepScenes, t.stepAssets, t.stepAssembly, t.stepOutput];
---

<div class="slp-app" aria-hidden="true">
  <nav class="slp-steps">
    <ol>
      {steps.map((label, i) => (
        <li class={i === 0 ? 'slp-step slp-step-here' : 'slp-step'}>
          <span>{label}</span>
        </li>
      ))}
    </ol>
  </nav>

  <div class="slp-statusbar">
    <span class="slp-sync slp-sync-syncing">{t.syncSyncing}</span>
  </div>

  <fieldset class="slp-group">
    <legend class="slp-legend">{t.keysTitle}</legend>
    <p class="slp-hint">{t.keysBlurb}</p>
  </fieldset>

  <div class="slp-loading"></div>
</div>
