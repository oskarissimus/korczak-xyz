---
/**
 * Navigation between the trainer's three views. Server-rendered rather than
 * part of the islands: every typing island is client:only, so anything inside
 * one is missing until React hydrates — and the nav is exactly what you want
 * working when hydration is slow or fails.
 */
import { translations, type Lang } from './translations';

type View = 'practice' | 'progress' | 'keys';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/games/typing' : '/games/typing';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'practice', href: `${base}/`, label: t.navPractice },
  { view: 'progress', href: `${base}/stats/`, label: t.navProgress },
  { view: 'keys', href: `${base}/keys/`, label: t.navKeys },
];
---

<nav class="typing-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="typing-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
