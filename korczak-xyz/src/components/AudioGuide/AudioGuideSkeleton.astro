---
/**
 * Server-rendered stand-in for <AudioGuide client:only="react" />: the bar, a map-shaped hole and
 * the footnote. Astro swaps it for the real island the moment React hydrates.
 *
 * It commits to nothing — the narration language is in localStorage and the map's rectangle is a
 * device permission away, neither of which exists at build time. What it is for is the height: the
 * map fills the viewport, and a page that renders empty and then grows by a screen is a page that
 * throws whatever you were reading off the bottom.
 *
 * The select is real markup rather than a grey box so the bar is exactly as tall before hydration
 * as after it.
 */
import { PRESET_LANGUAGES } from '../../utils/audioGuide/language';
import { translations, type Lang } from './translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<div class="ag-app" aria-hidden="true">
  <div class="ag-bar">
    <div class="ag-language">
      <span class="ag-language-label">{t.languageLabel}</span>
      <select class="ag-select" disabled>
        {PRESET_LANGUAGES.map((name) => <option>{name}</option>)}
      </select>
    </div>
  </div>

  <div class="ag-stage">
    <div class="ag-map ag-map-placeholder"></div>
    <div class="ag-overlay">
      <p class="ag-chip">{t.locating}</p>
    </div>
  </div>

  <p class="ag-foot">
    {t.pitch} {t.costNote}
    <span class="ag-credits">{t.credits}</span>
  </p>
</div>
