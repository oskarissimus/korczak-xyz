---
/**
 * Server-rendered stand-in for <Fretboard client:only="react" />, mirroring the start screen:
 * three figure tiles, the start button, and the settings block. Astro swaps it for the real
 * island the moment React hydrates.
 *
 * It stands in for the *start* screen specifically because that is what the island always
 * renders first — a sitting is something you begin, never something the page loads into.
 */
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const TILES = [t.due, t.fresh, t.mastered];
/* The settings rows, as how many buttons each holds — frets, scale, strings, ask,
   session length, new per session, string names, notation. Same rows as
   SettingsPanel, so the block reserves the height the real one will take, and the
   counts matter rather than only the row count: a row of six wraps at 320px where a
   row of two does not, and a stand-in that reserved three everywhere reserved the
   wrong height for both. SettingsPanel's twelve-button Key row is deliberately not
   here — it is rendered only once a scale is chosen, and no scale is the default a
   first visit hydrates into. */
const ROW_CHOICES = [4, 6, 6, 3, 3, 3, 2, 2];
---

<div class="fb-start" aria-hidden="true">
  <div class="fb-tiles">
    {
      TILES.map((label) => (
        <div class="fb-tile">
          <span class="fb-tile-value fb-skel-value">—</span>
          <span class="fb-tile-label">{label}</span>
        </div>
      ))
    }
  </div>

  <div class="fb-start-actions">
    <span class="fb-btn fb-btn--primary fb-btn--big">{t.start}</span>
  </div>

  <p class="fb-sync fb-sync--quiet">&nbsp;</p>

  <div class="fb-settings">
    <h3 class="fb-subhead">{t.settings}</h3>
    {
      ROW_CHOICES.map((choices) => (
        <div class="fb-setting">
          <span class="fb-setting-label">&nbsp;</span>
          <div class="fb-setting-controls">
            {Array.from({ length: choices }).map(() => (
              <span class="fb-choice">&nbsp;&nbsp;&nbsp;&nbsp;</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* The figures are the one thing the stand-in cannot know. A dash rather than a
     zero: a zero is a claim, and it would be wrong as often as not. */
  .fb-skel-value {
    color: var(--retro-dark-gray);
  }
</style>
