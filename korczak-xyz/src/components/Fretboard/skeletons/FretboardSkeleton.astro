---
/**
 * Server-rendered stand-in for <Fretboard client:only="react" />, mirroring the start screen:
 * three figure tiles, the start button, and the settings block. Astro swaps it for the real
 * island the moment React hydrates.
 *
 * It stands in for the *start* screen specifically because that is what the island always
 * renders first — a sitting is something you begin, never something the page loads into.
 */
import { STRING_COUNT, stringLabel } from '../../../utils/fretboard/notes';
import {
  FRET_CHOICES,
  LENGTH_CHOICES,
  NEW_CHOICES,
  fretChoiceLabel,
} from '../SettingsPanel';
import { defaultNotationFor, translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const TILES = [t.due, t.fresh, t.mastered];

/*
 * The settings rows, with the buttons' real labels.
 *
 * A count of buttons is not enough to reserve the right height, because what a row costs at 320px
 * is how many lines it wraps onto, and that is set by the width of the text on the buttons. Three
 * chips of blank space stood in for `Name the note` / `Find the note` / `Find the pitch` and did
 * not wrap where the real row wraps onto three lines; six of them were wider than six single
 * letters and wrapped where the strings row does not. The two errors were ~35px each and in
 * opposite directions, so the total looked closer than any row actually was.
 *
 * So the stand-in prints what the panel prints, from the same constants — the technique
 * `TypingSkeleton.astro` uses for the book picker, and for the same reason: nothing here is a
 * measurement to keep up to date. The notation is the locale's default, which is what an
 * un-hydrated page has no better guess than anyway.
 */
const notation = defaultNotationFor(lang);
const ROWS: { label: string; choices: (string | number)[] }[] = [
  { label: t.frets, choices: FRET_CHOICES.map(fretChoiceLabel) },
  {
    label: t.strings,
    choices: Array.from({ length: STRING_COUNT }, (_, i) =>
      stringLabel(STRING_COUNT - 1 - i, notation)
    ),
  },
  { label: t.directions, choices: [t.dirName, t.dirFind, t.dirPitch] },
  { label: t.sessionLength, choices: LENGTH_CHOICES },
  { label: t.newPerSession, choices: NEW_CHOICES },
  { label: t.stringLabels, choices: [t.on, t.off] },
  { label: t.notation, choices: [t.notationIntl, t.notationGerman] },
];
---

<div class="fb-start" aria-hidden="true">
  <div class="fb-tiles">
    {
      TILES.map((label) => (
        <div class="fb-tile">
          <span class="fb-tile-value fb-skel-value">—</span>
          <span class="fb-tile-label">{label}</span>
        </div>
      ))
    }
  </div>

  <div class="fb-start-actions">
    <span class="fb-btn fb-btn--primary fb-btn--big">{t.start}</span>
  </div>

  <p class="fb-sync fb-sync--quiet">&nbsp;</p>

  <div class="fb-settings">
    <h3 class="fb-subhead">{t.settings}</h3>
    {
      ROWS.map((row) => (
        <div class="fb-setting">
          <span class="fb-setting-label">{row.label}</span>
          <div class="fb-setting-controls">
            {row.choices.map((choice) => (
              <span class="fb-choice">{choice}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* The figures are the one thing the stand-in cannot know. A dash rather than a
     zero: a zero is a claim, and it would be wrong as often as not. */
  .fb-skel-value {
    color: var(--retro-dark-gray);
  }
</style>
