---
/**
 * Navigation between the feed, the interests, the notification settings and the sources.
 *
 * Server-rendered rather than part of the islands, for the reason the sleep log's is: all three
 * islands are client:only, so anything inside one is missing until React hydrates — and the nav is
 * exactly what you want working when hydration is slow or fails.
 */
import { translations, type Lang } from './translations';

type View = 'feed' | 'interests' | 'alerts' | 'sources';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/apps/events' : '/apps/events';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'feed', href: `${base}/`, label: t.navFeed },
  { view: 'interests', href: `${base}/interests/`, label: t.navInterests },
  { view: 'alerts', href: `${base}/alerts/`, label: t.navAlerts },
  { view: 'sources', href: `${base}/sources/`, label: t.navSources },
];
---

<nav class="win-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="win-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
