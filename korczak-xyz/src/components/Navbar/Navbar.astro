---
import { useTranslations, getAlternateLangPath, type Lang } from '../../i18n';
import NavAuth from '../Auth/NavAuth';
import NavAuthFallback from '../Auth/NavAuthFallback.astro';
import { AUTH_CACHE_KEY } from '../../lib/authCache';
import { execSync } from 'child_process';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

// Build-time info (runs at build, not in browser)
const commitHash = execSync('git rev-parse --short HEAD').toString().trim();
const buildTimestamp = new Date().toISOString();
const t = useTranslations(lang);

const navigation = [
  { name: t('Home'), to: lang === 'en' ? '/' : '/pl/', icon: '~' },
  { name: t('About'), to: lang === 'en' ? '/about/' : '/pl/about/', icon: '?' },
  { name: t('Mentoring'), to: lang === 'en' ? '/mentoring/' : '/pl/mentoring/', icon: '@' },
  { name: t('Courses'), to: lang === 'en' ? '/courses/' : '/pl/courses/', icon: '</>' },
  { name: t('Blog'), to: lang === 'en' ? '/blog/' : '/pl/blog/', icon: '#' },
  { name: t('Songs'), to: lang === 'en' ? '/songs/' : '/pl/songs/', icon: '*' },
  { name: t('Games'), to: lang === 'en' ? '/games/' : '/pl/games/', icon: '♠' },
];

// Get alternate language path for language switcher
const enPath = lang === 'en' ? currentPath : getAlternateLangPath(currentPath, lang, 'en');
const plPath = lang === 'pl' ? currentPath : getAlternateLangPath(currentPath, lang, 'pl');

// Check if a nav item is active (current page)
function isActive(itemPath: string): boolean {
  // Exact match for home page
  if (itemPath === '/' || itemPath === '/pl/') {
    return currentPath === itemPath;
  }
  // For other pages, check if currentPath starts with the item path
  return currentPath.startsWith(itemPath);
}
---

<div class="window navbar-window">
  <div class="title-bar">
    <span class="site-title">korczak.xyz - Navigator</span>
    <div class="title-buttons">
      <div class="title-btn minimize-btn"></div>
      <div class="title-btn maximize-btn"></div>
      <div class="title-btn close-btn"></div>
    </div>
  </div>

  <div class="navbar-content">
    <!-- Mobile menu button -->
    <button class="menu-btn" id="menu-button" aria-label="Menu">
      [MENU]
    </button>

    <!-- Navigation links -->
    <nav id="main-nav" class="nav-links">
      {navigation.map(item => (
        <a href={item.to} class={`nav-link ${isActive(item.to) ? 'active' : ''}`}>
          <span class="nav-icon">{item.icon}</span>
          <span class="nav-text">{item.name}</span>
        </a>
      ))}

      <!-- Right-aligned group: auth control + language switcher -->
      <div class="nav-right">
        {/* Persisted so a page change never unmounts it. Only the islands are persisted, not
            the whole window: the links, the active state and the switcher below must keep
            coming from the server for whichever page was just navigated to. */}
        <NavAuth client:only="react" transition:persist="nav-auth-control" lang={lang} variant="control" />

        <!-- Language switcher -->
        <div class="lang-switcher">
          <a href={enPath} class={`lang-btn ${lang === 'en' ? 'active' : ''}`}>EN</a>
          <span class="lang-divider">|</span>
          <a href={plPath} class={`lang-btn ${lang === 'pl' ? 'active' : ''}`}>PL</a>
        </div>
      </div>
    </nav>

  </div>

  <!-- Status bar (Windows 95 style) -->
  <div class="status-bar">
    <div class="status-panel">
      <a href={`https://github.com/oskarissimus/korczak-xyz/commit/${commitHash}`} target="_blank" rel="noopener">{commitHash}</a>
    </div>
    <div class="status-panel status-panel--updated" id="navbar-updated" data-timestamp={buildTimestamp}>
      <span class="status-label status-label--long">{t('statusBar.lastUpdated')}</span>
      <span class="status-label status-label--short">{t('statusBar.updated')}</span>
      <span class="build-time build-time--long">{buildTimestamp}</span>
      <span class="build-time build-time--short">{buildTimestamp}</span>
    </div>
    <div class="status-user">
      <NavAuth client:only="react" transition:persist="nav-auth-identity" lang={lang} variant="identity">
        <NavAuthFallback slot="fallback" />
      </NavAuth>
    </div>
  </div>
</div>

{/* Paints the email before anything else can. Inline and in the body, so it runs while the
    parser is still here and the address is on screen in the first frame - a bundled script
    would run after paint, and one in <head> would run before these spans exist. React then
    hydrates from the same cache with the same string, so there is nothing to see. */}
<script is:inline define:vars={{ cacheKey: AUTH_CACHE_KEY }}>
  (function () {
    // The fallback tree parsed just above. Absent once React has taken over the island,
    // which is exactly when this has nothing left to do.
    var el = document.querySelector('[data-nav-auth-email]');
    if (!el) return;

    var email;
    try {
      var cached = JSON.parse(window.localStorage.getItem(cacheKey) || 'null');
      email = cached && typeof cached.email === 'string' ? cached.email : null;
    } catch (e) {
      email = null;
    }
    if (!email) return;

    // Split at the last '@' exactly as splitEmail() does, so the three runs match what
    // React will render and the '@' keeps its own element (see NavAuth.tsx on iOS data
    // detectors). No folding here: the address is clipped by CSS until React measures the
    // bar and abbreviates it properly.
    var at = email.lastIndexOf('@');
    var local = at > 0 ? email.slice(0, at) : email;
    var domain = at > 0 ? email.slice(at + 1) : '';

    el.querySelector('[data-part="local"]').textContent = local;
    el.querySelector('[data-part="at"]').textContent = at > 0 ? '@' : '';
    el.querySelector('[data-part="domain"]').textContent = domain;
    el.title = email;
    el.classList.add('nav-auth-email');
    el.hidden = false;
  })();
</script>

<style>
  .navbar-window {
    margin-bottom: 20px;
  }

  .site-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .navbar-content {
    background: var(--retro-gray);
    padding: 6px 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .menu-btn {
    display: none;
    background: var(--retro-gray);
    border: 2px outset var(--retro-white);
    padding: 5px 10px;
    font-family: 'VT323', monospace;
    font-size: 1rem;
    cursor: pointer;
    color: var(--retro-black);
  }

  .menu-btn:active {
    border-style: inset;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    width: 100%;
  }

  .nav-link {
    background: var(--retro-gray);
    border: 2px outset var(--retro-white);
    padding: 6px 12px;
    text-decoration: none;
    color: var(--retro-black);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: none;
  }

  .nav-link:hover {
    background: #a0a0a0;
    color: var(--retro-black);
  }

  .nav-link:active,
  .nav-link.active {
    border-style: inset;
    background: #a0a0a0;
  }

  .nav-icon {
    color: var(--retro-navy);
    font-weight: bold;
  }

  .nav-text {
    color: var(--retro-black);
  }

  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--retro-teal);
    padding: 5px 10px;
    border: 2px inset var(--retro-dark-gray);
  }

  .lang-btn {
    color: var(--retro-yellow);
    text-decoration: none;
    font-weight: bold;
    padding: 2px 5px;
  }

  .lang-btn:hover {
    color: var(--retro-white);
  }

  .lang-btn.active {
    background: var(--retro-navy);
    color: var(--retro-white);
  }

  .lang-divider {
    color: var(--retro-yellow);
  }

  .status-bar {
    display: flex;
    background: var(--retro-gray);
    padding: 2px;
    gap: 2px;
  }

  .status-panel {
    background: var(--retro-gray);
    border: 2px solid;
    border-color: var(--retro-dark-gray) var(--retro-white) var(--retro-white) var(--retro-dark-gray);
    padding: 1px 4px;
    font-size: 0.8rem;
    color: var(--retro-black);
  }

  .status-panel:first-child {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* Middle panel fills the gap so the user panel hugs the right edge. Never let it
     wrap — a second line would double the height of the whole status bar. It may shrink,
     but only after the email has folded as far as it can (see .status-user below). */
  .status-panel--updated {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Long/short variants of the label and the timestamp; the media query below swaps
     them so the bar still fits on one line on a phone. */
  .status-label--short,
  .build-time--short {
    display: none;
  }

  /* Transparent wrapper: when logged out the identity island renders nothing,
     so no empty inset box is shown. The panel border lives on the email span
     (styled globally in auth.css, since React renders it outside Astro scoping).
     The lopsided shrink factor means this — not the timestamp — is what gives way when
     the bar runs out of room; the email is already an abbreviation and keeps a title
     tooltip, whereas a clipped timestamp is just unreadable. */
  .status-user {
    flex: 0 100 auto;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .status-panel a {
    color: var(--retro-black);
    text-decoration: none;
  }

  .status-panel a:hover {
    text-decoration: underline;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .menu-btn {
      display: block;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      margin-top: 10px;
    }

    .nav-links.show {
      display: flex;
    }

    .nav-link {
      justify-content: flex-start;
    }

    .nav-right {
      margin-left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 5px;
    }

    .lang-switcher {
      margin-left: 0;
      justify-content: center;
    }
  }

  /* Phones: swap in the terse label and the compact timestamp. Narrower than the nav
     breakpoint above, because the status bar still fits on a small tablet. */
  @media (max-width: 600px) {
    .status-label--long,
    .build-time--long {
      display: none;
    }

    .status-label--short,
    .build-time--short {
      display: inline;
    }

    /* Same treatment the title bar already gets at this width — the extra few
       characters it buys are what keep all three panels on one line. */
    .status-panel {
      font-size: 0.7rem;
      padding: 1px 2px;
    }

    .status-bar {
      padding: 1px;
      gap: 1px;
    }
  }
</style>

<script>
  // Everything here binds to navbar elements, and client-side routing replaces those on
  // every navigation while running this module only once. Hence an init driven by
  // `astro:page-load`; the elements it finds are always the current page's, so re-binding
  // cannot stack up listeners.
  function initNavbar() {
    const menuButton = document.getElementById('menu-button');
    const mainNav = document.getElementById('main-nav');

    menuButton?.addEventListener('click', () => {
      mainNav?.classList.toggle('show');
    });

    // Format build timestamp. Two variants: the locale-aware long one for wide screens,
    // and a compact ISO-style one for phones (CSS picks which is visible).
    const updatedEl = document.getElementById('navbar-updated');
    const timestamp = updatedEl?.dataset.timestamp;
    if (updatedEl && timestamp) {
      const date = new Date(timestamp);
      const lang = document.documentElement.lang || 'en';
      const locale = lang === 'pl' ? 'pl-PL' : 'en-US';

      const long = date.toLocaleString(locale, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });

      // YYYY-MM-DD HH:MM in local time — 16 chars, unambiguous, and the same in every
      // locale, so it needs no translation.
      const pad = (n: number) => String(n).padStart(2, '0');
      const short = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;

      const longEl = updatedEl.querySelector('.build-time--long');
      const shortEl = updatedEl.querySelector('.build-time--short');
      if (longEl) longEl.textContent = long;
      if (shortEl) shortEl.textContent = short;

      // Keeps the full date reachable when the compact form is showing.
      updatedEl.title = long;
    }
  }

  // `astro:page-load` covers the first load too, so this is the only call site needed.
  document.addEventListener('astro:page-load', initNavbar);
</script>
