---
/**
 * Server-rendered stand-in for <BabySleepClimate client:only="react" />: the entry card, the chart
 * and the history heading, so the page does not jump by several hundred pixels when the island
 * arrives. Nothing here may import `climateStorage.ts` — this runs on the server.
 *
 * The night's date is deliberately not filled in. The server's clock is not the reader's, and a
 * date that flickers from one day to another as React takes over is worse than one that arrives
 * once, correct.
 */
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const FIELDS = [t.climateNight, t.climateTemp, t.climateWindow, t.climateVerdict];
---

<div class="bs-climate" aria-hidden="true">
  <p class="bs-hint">{t.climateIntro}</p>

  <div class="bs-form bs-climate-form">
    <h2 class="bs-subhead">{t.climateTitle}</h2>
    {
      FIELDS.map((label) => (
        <div class="bs-field">
          <span class="bs-field-label">{label}</span>
          <div class="bs-skel-field" />
        </div>
      ))
    }
  </div>

  <section class="bs-section">
    <h2 class="bs-subhead">{t.climateChartTitle}</h2>
    <div class="bs-chart bs-chart--skeleton">
      <!-- The readout line the hydrated chart carries. Reserved here too, or every chart on the
           page jumps down by its height the moment the island mounts. -->
      <p class="chart-readout chart-readout--idle"></p>
    </div>
  </section>

  <section class="bs-section">
    <h2 class="bs-subhead">{t.climateHistoryTitle}</h2>
  </section>
</div>
