---
/**
 * Server-rendered stand-in for <BabySleepStats client:only="react" />: the window picker, the tile row
 * and the chart sections, so the page does not jump by several hundred pixels when the island
 * arrives. Nothing here may import `storage.ts` — this runs on the server.
 */
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const TILES = [
  t.tileTotal,
  t.tileNight,
  t.tileNightWakes,
  t.tileNightAwake,
  t.tileNaps,
  t.tileNapCount,
  t.tileNapLength,
  t.tileBedtime,
  t.tileWake,
  t.tileFirstNap,
];

const SECTIONS = [t.timelineTitle, t.totalsTitle, t.nightLengthTitle, t.bedtimeTitle];
---

<div class="bs-stats" aria-hidden="true">
  <div class="bs-window-picker">
    <span class="bs-field-label">{t.windowLabel}</span>
    <div class="bs-toggle">
      <span class="bs-toggle-btn bs-skel">{t.window3d}</span>
      <span class="bs-toggle-btn bs-toggle-btn--on bs-skel">{t.window7d}</span>
      <span class="bs-toggle-btn bs-skel">{t.window30d}</span>
      <span class="bs-toggle-btn bs-skel">{t.windowCustom}</span>
    </div>
  </div>

  <div class="bs-tiles">
    {
      TILES.map((label) => (
        <div class="bs-tile">
          <span class="bs-tile-value">{t.noData}</span>
          <span class="bs-tile-label">{label}</span>
          <span class="bs-tile-of" />
        </div>
      ))
    }
  </div>

  <p class="bs-note">{t.statsNote}</p>

  {
    SECTIONS.map((title) => (
      <section class="bs-section">
        <h2 class="bs-subhead">{title}</h2>
        <div class="bs-chart bs-chart--skeleton" />
      </section>
    ))
  }
</div>
