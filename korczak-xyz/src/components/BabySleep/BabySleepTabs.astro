---
/**
 * Navigation between the log and the stats. Server-rendered rather than part of the islands: both
 * islands are client:only, so anything inside one is missing until React hydrates — and the nav is
 * exactly what you want working when hydration is slow or fails.
 */
import { translations, type Lang } from './translations';

type View = 'log' | 'stats' | 'share';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/games/baby-sleep' : '/games/baby-sleep';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'log', href: `${base}/`, label: t.navLog },
  { view: 'stats', href: `${base}/stats/`, label: t.navStats },
  { view: 'share', href: `${base}/share/`, label: t.navShare },
];
---

<nav class="win-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="win-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
