---
/**
 * The bedtime routine, as a sheet to tick through on the phone and as one to print and hang up -
 * the same ten rows either way, which is the point: whoever is following the paper on the wall and
 * whoever is following the screen are on the same step.
 *
 * The ticks are this evening's and this device's, and deliberately go nowhere near Firestore: what
 * is worth keeping about a routine is already kept, as the `RoutineRecord` the log writes. See
 * `checklist.ts`.
 */
import { translations, type Lang } from './translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

/* The order is the order of the evening. Ten steps is what fits one A4 page at a size readable
   from across a bathroom; adding an eleventh means checking the print preview again. */
const steps: { icon: string; label: string }[] = [
  { icon: '\u{1F95B}', label: t.checklistDrink },
  { icon: '\u{1F6C1}', label: t.checklistBath },
  { icon: '\u{1F9F7}', label: t.checklistNappy },
  { icon: '\u{1F455}', label: t.checklistPyjamas },
  { icon: '\u{1FAA5}', label: t.checklistTeeth },
  { icon: '\u{1F443}', label: t.checklistNose },
  { icon: '\u{1F6BD}', label: t.checklistWee },
  { icon: '\u{1F4D6}', label: t.checklistBook },
  { icon: '\u{1F3B5}', label: t.checklistSong },
  { icon: '\u{1F534}', label: t.checklistLamp },
];
---

<div class="nr-toolbar">
  <button type="button" class="nr-btn" id="nr-print">{t.checklistPrint}</button>
  <button type="button" class="nr-btn" id="nr-reset">{t.checklistReset}</button>
  <p class="nr-hint">{t.checklistHint}</p>
</div>

<div class="nr-preview">
  <div class="nr-sheet">
    <div class="nr-frame">
      <header class="nr-head">
        <span class="nr-moon">{'☾'} {'✦'} {'✧'}</span>
        <h1 class="nr-title">{t.checklistTitle}</h1>
        <p class="nr-subtitle">{t.checklistSubtitle}</p>
      </header>

      <ol class="nr-list">
        {steps.map((step, i) => (
          <li class="nr-step">
            {/* A real checkbox inside a label, so the whole row is the hit area and the keyboard
                and the screen reader get the control for free. What is ticked prints ticked -
                the preview is the page - and "Start over" sits next to Print for the blank one
                that goes on the wall. */}
            <label class="nr-item">
              <span class="nr-num">{i + 1}</span>
              <span class="nr-icon" aria-hidden="true">{step.icon}</span>
              <span class="nr-label">{step.label}</span>
              <input type="checkbox" class="nr-box" data-step={i} />
            </label>
          </li>
        ))}
      </ol>

      <footer class="nr-foot">
        <span>{t.checklistGoodnight} {'☾'}</span>
        <span class="nr-site">korczak.xyz</span>
      </footer>
    </div>
  </div>
</div>

<script>
  import { loadChecklist, saveChecklist } from '../../utils/babySleep/checklist';

  // astro:page-load rather than a bare listener: the site routes on the client, so a tab
  // arrived at from the nav above never fires DOMContentLoaded again.
  document.addEventListener('astro:page-load', () => {
    const sheet = document.querySelector('.nr-sheet');
    if (!sheet) return;

    const boxes = [...sheet.querySelectorAll<HTMLInputElement>('.nr-box')];
    const print = document.getElementById('nr-print');
    const reset = document.getElementById('nr-reset');

    // The clock is read at every write rather than once here: a tab left open through the
    // evening would otherwise keep saving under the night it was opened in.
    const ticked = () => boxes.flatMap((box, i) => (box.checked ? [i] : []));
    const save = () => saveChecklist(Date.now(), ticked());

    for (const i of loadChecklist(Date.now(), boxes.length)) {
      const box = boxes[i];
      if (box) box.checked = true;
    }

    for (const box of boxes) box.addEventListener('change', save);

    print?.addEventListener('click', () => window.print());
    reset?.addEventListener('click', () => {
      for (const box of boxes) box.checked = false;
      save();
    });
  });
</script>
