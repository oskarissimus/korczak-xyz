---
/**
 * Server-rendered stand-in for <ShoppingShare client:only="react" />.
 *
 * It draws the owner's layout — heading, intro, the add row, the list heading — because that is the
 * state the person who can actually reach this tab will nearly always be in, and matching it keeps
 * the page from jumping when the island lands. It commits to no *content*: no addresses, and no
 * claim about whether the list is shared, neither of which is knowable before Firestore has been
 * asked. Nothing here may import `storage.ts` or `shares.ts` — this runs on the server.
 */
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<div class="sl-share" aria-hidden="true">
  <section class="sl-section">
    <h2 class="sl-subhead">{t.shareTitle}</h2>
    <p class="sl-note">{t.shareIntro}</p>
    <p class="sl-note">{t.shareScope}</p>
    <div class="sl-share-form">
      <span class="sl-field-label">{t.shareAddLabel}</span>
      <div class="sl-share-row">
        <span class="sl-input sl-skel"></span>
        <span class="sl-action sl-skel">{t.shareAddButton}</span>
      </div>
      <p class="sl-hint">{t.shareAddHint}</p>
    </div>
  </section>

  <section class="sl-section">
    <h3 class="sl-subhead">{t.shareListTitle}</h3>
    <p class="sl-hint"></p>
  </section>
</div>
