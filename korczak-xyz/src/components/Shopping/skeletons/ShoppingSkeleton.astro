---
/**
 * Server-rendered stand-in for <ShoppingList client:only="react" />, mirroring the list tab: the add
 * box and the to-buy heading. Astro swaps it for the real island the moment React hydrates.
 *
 * It commits to no *lines*, and it cannot: they are in localStorage and this runs on the server.
 * Nothing here may import `storage.ts` for that reason — the empty-list hint is deliberately absent
 * too, since claiming the list is empty a beat before it fills is worse than a blank space.
 */
import { translations, type Lang } from '../translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<div class="sl-list" aria-hidden="true">
  <section class="sl-add">
    <div class="sl-add-form">
      <div class="sl-add-row">
        <div class="sl-add-field sl-add-field--name">
          <span class="sl-field-label">{t.addLabel}</span>
          <span class="sl-skel-field"></span>
        </div>
        <div class="sl-add-field sl-add-field--note">
          <span class="sl-field-label">{t.noteLabel}</span>
          <span class="sl-skel-field"></span>
        </div>
      </div>
      <span class="sl-big sl-big--add sl-skel">{t.addButton}</span>
    </div>
  </section>

  <section class="sl-section">
    <h2 class="sl-subhead">{t.todoTitle}</h2>
  </section>
</div>
