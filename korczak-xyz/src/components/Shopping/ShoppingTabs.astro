---
/**
 * Navigation between the list and the sharing panel. Server-rendered rather than part of the
 * islands: both islands are client:only, so anything inside one is missing until React hydrates —
 * and the nav is exactly what you want working when hydration is slow or fails.
 */
import { translations, type Lang } from './translations';

type View = 'list' | 'share';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/apps/shopping' : '/apps/shopping';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'list', href: `${base}/`, label: t.navList },
  { view: 'share', href: `${base}/share/`, label: t.navShare },
];
---

<nav class="win-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="win-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
