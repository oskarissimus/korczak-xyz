---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const homeLink = lang === 'en' ? '/' : '/pl/';
---

<footer class="retro-footer">
  <div class="marquee-container">
    <div class="marquee-text">{t('footer.marquee')}</div>
  </div>

  <div class="under-construction">
    <div class="construction-gif"></div>
    <span class="construction-text">{t('footer.underConstruction')} - <a href={homeLink}>korczak.xyz</a> - {t('footer.established')}</span>
    <div class="construction-gif"></div>
  </div>

  <div class="footer-counter">
    <div class="visitor-counter">
      <span>{t('hero.visitors')}: 1337420</span>
    </div>
  </div>
</footer>

<style>
  .retro-footer {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  /* A flex item, so it is blockified and `text-align` reaches its own lines. It keeps the
     default `min-width: auto` - it may shrink to its longest word and no further, which is
     what stops it overflowing rather than wrapping on the narrowest screens. `balance` splits
     the two lines evenly instead of leaving `- Est. 2024` alone under a full line. */
  .construction-text {
    color: var(--retro-yellow);
    font-size: 1rem;
    text-align: center;
    text-wrap: balance;
  }

  .construction-text a {
    color: var(--retro-cyan);
  }

  .footer-counter {
    display: flex;
    justify-content: center;
    margin-top: 10px;
  }
</style>
