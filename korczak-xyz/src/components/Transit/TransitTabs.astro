---
/**
 * Navigation between the four tabs.
 *
 * Server-rendered rather than part of the islands, for the reason the events app's is: every island
 * is `client:only`, so anything inside one is missing until React hydrates — and the nav is exactly
 * what you want working when hydration is slow or fails.
 */
import { translations, type Lang } from './translations';

type View = 'feed' | 'routes' | 'alerts' | 'raw';

interface Props {
  lang: Lang;
  active: View;
}

const { lang, active } = Astro.props;
const t = translations[lang];

const base = lang === 'pl' ? '/pl/apps/transit' : '/apps/transit';

const TABS: { view: View; href: string; label: string }[] = [
  { view: 'feed', href: `${base}/`, label: t.navFeed },
  { view: 'routes', href: `${base}/routes/`, label: t.navRoutes },
  { view: 'alerts', href: `${base}/alerts/`, label: t.navAlerts },
  { view: 'raw', href: `${base}/raw/`, label: t.navRaw },
];
---

<nav class="win-tabs" aria-label={t.navLabel}>
  {
    TABS.map(({ view, href, label }) => (
      <a class="win-tab" href={href} aria-current={view === active ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
