---
import Layout from '../layouts/Layout.astro';
import PageContent from '../components/PageContent.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = [
  ['privacy.who.title', 'privacy.who.body'],
  ['privacy.publicPages.title', 'privacy.publicPages.body'],
  ['privacy.localData.title', 'privacy.localData.body'],
  ['privacy.account.title', 'privacy.account.body'],
  ['privacy.notifications.title', 'privacy.notifications.body'],
  ['privacy.hosting.title', 'privacy.hosting.body'],
  ['privacy.contact.title', 'privacy.contact.body'],
] as const;
---

<Layout title={`${t('privacy.title')} | korczak.xyz`} lang={lang}>
  <PageContent title={t('privacy.title')}>
    <p class="legal-updated">{t('privacy.updated')}</p>
    {
      sections.map(([title, body]) => (
        <section class="legal-section">
          <h2>{t(title)}</h2>
          <p>{t(body)}</p>
        </section>
      ))
    }
  </PageContent>
</Layout>

<style>
  .legal-updated {
    color: var(--retro-yellow);
  }

  .legal-section h2 {
    color: var(--retro-cyan);
    margin-bottom: 10px;
  }

  .legal-section p {
    color: var(--retro-white);
    text-align: justify;
  }
</style>
