---
import MenuSkeleton from '../components/MenuSkeleton.astro';
import Game from '../layouts/Game.astro';
import Rpg from '../../src/components/Rpg/Rpg';
import { useTranslations } from '../../src/i18n';
import '../../src/styles/rpg.css';
import '../styles/standalone.css';
// The keys' cards in Settings (Rpg/SettingsKeys.tsx).
import '../../src/styles/account.css';
import '../../src/styles/rpg-account.css';
// The admin panel, Settings' last tab for admins (Rpg/AdminPanel.tsx).
import '../../src/styles/chartReadout.css';
import '../../src/styles/rpgAdminCosts.css';
import '../../src/styles/rpg-admin.css';

const lang = 'en';
const t = useTranslations(lang);
---

<Game title={t('Rpg')} lang={lang} path="/">
  <main class="rpg-content rpg-standalone">
    <Rpg client:only="react" lang={lang} standalone>
      <Fragment slot="fallback"><MenuSkeleton lang={lang} /></Fragment>
    </Rpg>
  </main>
</Game>
