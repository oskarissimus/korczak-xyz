---
import Game from '../../layouts/Game.astro';
import RpgRules from '../../../src/components/Rpg/RpgRules.astro';
import { useTranslations } from '../../../src/i18n';
import '../../styles/pages.css';

const lang = 'pl';
const t = useTranslations(lang);
const title = 'Wędrowiec: zasady treści';
---

<Game title={`${title} · ${t('Rpg')}`} lang={lang} path="/rules/">
  <main class="rpg-page rpg-rules">
    <h1>{title}</h1>
    <RpgRules lang={lang} gameHref="/pl/" termsHref="https://korczak.xyz/pl/terms/" />
  </main>
</Game>
