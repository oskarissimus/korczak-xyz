---
/**
 * The commit and the build time, small at the bottom of every page of everyrpg.korczak.xyz — the
 * same two things korczak.xyz's navbar prints, so a phone can tell which build it is playing
 * (owner, 9 Nov 2026). The hash is `git rev-parse --short HEAD` like Navbar.astro's; the time is
 * when the build ran, shown in the viewer's own zone.
 *
 * It never takes a tap, and nothing of the page sits under it: every page ends `--stamp-h` above
 * the bottom edge. Polling a deploy reads `data-commit` from the HTML.
 *
 * The strip also carries the legal pages (components/Rpg/RpgLegal.astro) on the left, the one
 * thing on it that takes a tap (owner, 15 Nov 2026: terms, privacy, refunds and prices for Paddle,
 * reachable from every page, the home screen included, without adding to it).
 *
 * The links follow THE GAME'S language, not the page's (owner, 19 Nov 2026: the game in English on
 * /pl/ still offered "Cennik", which opened the Polish price list he had to paste into Paddle). The
 * game's language is its own choice (`rpg-lang`, `startingLang`), so the game publishes it as
 * `<html data-game-lang>` and the strip follows it; on a page without the game, the stored choice.
 * Only English and Polish have legal pages, so any other language gets the English ones.
 */
import { execSync } from 'node:child_process';
import type { Lang } from '../../src/i18n';

const { lang } = Astro.props as { lang: Lang };
const prefix = lang === 'pl' ? '/pl' : '';
const legal: [string, string][] =
  lang === 'pl'
    ? [
        ['terms', 'Regulamin'],
        ['privacy', 'Prywatność'],
        ['refunds', 'Zwroty'],
        ['pricing', 'Cennik'],
      ]
    : [
        ['terms', 'Terms'],
        ['privacy', 'Privacy'],
        ['refunds', 'Refunds'],
        ['pricing', 'Pricing'],
      ];

let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {
  // A checkout with no .git still builds.
}
const built = new Date().toISOString();
---

<div class="build-stamp" data-commit={commit} data-built={built}>
  <nav class="build-legal">{legal.map(([page, label]) => <a href={`${prefix}/${page}/`} data-page={page}>{label}</a>)}</nav>
  <span class="build-id" aria-hidden="true">
    {commit}<span class="build-time"> · <time datetime={built}>{built.slice(0, 16).replace('T', ' ')} UTC</time></span>
  </span>
</div>

<script>
  const LEGAL: Record<'en' | 'pl', Record<string, string>> = {
    en: { terms: 'Terms', privacy: 'Privacy', refunds: 'Refunds', pricing: 'Pricing' },
    pl: { terms: 'Regulamin', privacy: 'Prywatność', refunds: 'Zwroty', pricing: 'Cennik' },
  };
  function legalIn(game: string | undefined) {
    const l = game === 'pl' ? 'pl' : 'en';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.build-legal a[data-page]')) {
      const page = a.dataset.page ?? '';
      a.textContent = LEGAL[l][page] ?? a.textContent;
      a.href = `${l === 'pl' ? '/pl' : ''}/${page}/`;
    }
  }
  const root = document.documentElement;
  let stored: string | undefined;
  try {
    const chosen = JSON.parse(localStorage.getItem('rpg-lang') || 'null');
    if (chosen && typeof chosen.lang === 'string') stored = chosen.lang;
  } catch {
    /* a blocked store: the page's language */
  }
  legalIn(root.dataset.gameLang ?? stored ?? root.lang);
  new MutationObserver(() => legalIn(root.dataset.gameLang)).observe(root, { attributes: true, attributeFilter: ['data-game-lang'] });

  for (const el of document.querySelectorAll<HTMLElement>('.build-stamp time')) {
    const at = new Date(el.dateTime);
    if (!Number.isNaN(at.getTime())) {
      el.textContent = at.toLocaleString(document.documentElement.lang === 'pl' ? 'pl-PL' : 'en-GB', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }
  }
</script>

<style>
  /* A black strip across the bottom, and the page ends above it rather than under it
     (`--stamp-h` in layouts/Game.astro: the body is padded by it, the game shortened by it): on top of
     the game's world cards the text alone was unreadable (owner, 9 Nov 2026, a photo). */
  .build-stamp {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--stamp-h);
    padding-bottom: var(--safe-bottom, 0px);
    z-index: 1001; /* over the game in immersive mode (styles/rpg.css, 1000) */
    pointer-events: none;
    background: #000;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-left: calc(8px + var(--safe-left, 0px));
    padding-right: calc(8px + var(--safe-right, 0px));
    white-space: nowrap;
    overflow: hidden;
    font: 10px/16px ui-monospace, Menlo, Consolas, monospace;
    color: rgba(241, 230, 207, 0.6);
  }
  .build-legal {
    display: flex;
    gap: 10px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .build-legal a {
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }
  .build-legal a:hover,
  .build-legal a:focus-visible {
    color: #f1e6cf;
    text-decoration: underline;
  }
  @media (max-width: 400px) {
    .build-time {
      display: none;
    }
  }
</style>
