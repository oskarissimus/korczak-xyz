---
/**
 * The commit and the build time, small at the bottom of every page of everyrpg.korczak.xyz — the
 * same two things korczak.xyz's navbar prints, so a phone can tell which build it is playing
 * (owner, 9 Nov 2026). The hash is `git rev-parse --short HEAD` like Navbar.astro's; the time is
 * when the build ran, shown in the viewer's own zone.
 *
 * It never takes a tap, and nothing of the page sits under it: every page ends `--stamp-h` above
 * the bottom edge. Polling a deploy reads `data-commit` from the HTML.
 */
import { execSync } from 'node:child_process';

let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {
  // A checkout with no .git still builds.
}
const built = new Date().toISOString();
---

<div class="build-stamp" aria-hidden="true" data-commit={commit} data-built={built}>
  {commit} · <time datetime={built}>{built.slice(0, 16).replace('T', ' ')} UTC</time>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.build-stamp time')) {
    const at = new Date(el.dateTime);
    if (!Number.isNaN(at.getTime())) {
      el.textContent = at.toLocaleString(document.documentElement.lang === 'pl' ? 'pl-PL' : 'en-GB', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }
  }
</script>

<style>
  /* A black strip across the bottom, and the page ends above it rather than under it
     (`--stamp-h` in layouts/Game.astro: the body is padded by it, the game shortened by it): on top of
     the game's world cards the text alone was unreadable (owner, 9 Nov 2026, a photo). */
  .build-stamp {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--stamp-h);
    padding-bottom: var(--safe-bottom, 0px);
    z-index: 1001; /* over the game in immersive mode (styles/rpg.css, 1000) */
    pointer-events: none;
    background: #000;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    font: 10px/16px ui-monospace, Menlo, Consolas, monospace;
    color: rgba(241, 230, 207, 0.6);
  }
</style>
