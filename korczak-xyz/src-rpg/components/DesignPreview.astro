---
/**
 * The switcher between the candidate looks (src/utils/rpg/designs.ts), shown only while one is on
 * (`?design=…`). Without it nobody sees this: the game in production has no `data-rpg-design`.
 * ‹ › step through the ten live, on whatever screen is open; ✕ goes back to the current look; the
 * name links to /designs/, every screen in every look side by side.
 */
import type { Lang } from '../../src/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings =
  lang === 'pl'
    ? { prev: 'Poprzedni wygląd', next: 'Następny wygląd', off: 'Wróć do obecnego wyglądu', all: 'Wszystkie warianty' }
    : { prev: 'Previous look', next: 'Next look', off: 'Back to the current look', all: 'All variants' };
const gallery = lang === 'pl' ? '/pl/designs/' : '/designs/';
---

<div class="design-preview" hidden data-lang={lang}>
  <button type="button" class="design-preview-step" data-step="-1" aria-label={strings.prev} title={strings.prev}>‹</button>
  <a class="design-preview-name" href={gallery} title={strings.all}></a>
  <button type="button" class="design-preview-step" data-step="1" aria-label={strings.next} title={strings.next}>›</button>
  <button type="button" class="design-preview-off" aria-label={strings.off} title={strings.off}>✕</button>
</div>

<script>
  import { DESIGNS, DESIGN_STORAGE_KEY } from '../../src/utils/rpg/designs';

  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>('.design-preview');
  const name = bar?.querySelector<HTMLAnchorElement>('.design-preview-name');
  const lang = bar?.dataset.lang === 'pl' ? 'pl' : 'en';

  /** Puts the look on the page, in this browser's memory and in the address, so a reload or a shared link keeps it. */
  function apply(id: string | null) {
    try {
      if (id) localStorage.setItem(DESIGN_STORAGE_KEY, id);
      else localStorage.removeItem(DESIGN_STORAGE_KEY);
    } catch {
      // No storage: the page still changes.
    }
    if (id) root.dataset.rpgDesign = id;
    else delete root.dataset.rpgDesign;
    const url = new URL(location.href);
    if (id) url.searchParams.set('design', id);
    else url.searchParams.delete('design');
    history.replaceState(history.state, '', url);
    render();
    window.dispatchEvent(new CustomEvent('rpg-design', { detail: id }));
  }

  function render() {
    if (!bar || !name) return;
    const i = DESIGNS.findIndex((d) => d.id === root.dataset.rpgDesign);
    bar.hidden = i < 0;
    if (i >= 0) name.textContent = `${i + 1} · ${DESIGNS[i].name[lang]}`;
  }

  bar?.querySelectorAll<HTMLButtonElement>('.design-preview-step').forEach((b) =>
    b.addEventListener('click', () => {
      const i = Math.max(0, DESIGNS.findIndex((d) => d.id === root.dataset.rpgDesign));
      const step = Number(b.dataset.step);
      apply(DESIGNS[(i + step + DESIGNS.length) % DESIGNS.length].id);
    }),
  );
  bar?.querySelector('.design-preview-off')?.addEventListener('click', () => apply(null));
  // The gallery page picks looks too; it says so with the same event.
  window.addEventListener('rpg-design-pick', (e) => apply((e as CustomEvent<string | null>).detail));
  render();
</script>

<style>
  .design-preview {
    position: fixed;
    left: calc(8px + var(--safe-left, 0px));
    bottom: calc(var(--stamp-h, 16px) + 8px);
    z-index: 1002;
    display: flex;
    align-items: stretch;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.78);
    color: #fff;
    font: 13px/1 system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  }

  .design-preview[hidden] {
    display: none;
  }

  /* Out of the way of the thumbs while playing on a phone. */
  :global(body:has(.rpg-immersive)) .design-preview {
    display: none;
  }

  .design-preview button,
  .design-preview a {
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .design-preview-step {
    font-size: 20px !important;
  }

  .design-preview a {
    min-width: 7.5em;
    justify-content: center;
    font-weight: 600;
  }

  .design-preview button:hover,
  .design-preview a:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .design-preview-off {
    border-left: 1px solid rgba(255, 255, 255, 0.25) !important;
    opacity: 0.8;
  }
</style>
