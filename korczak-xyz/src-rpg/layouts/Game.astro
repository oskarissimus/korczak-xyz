---
/**
 * The frame every page of everyrpg.korczak.xyz is drawn in — on purpose almost nothing. See README.md.
 */
import { useTranslations, type Lang } from '../../src/i18n';
import islandRecovery from '../../src/scripts/island-recovery.js?raw';
import { iconUrl } from '../../src/utils/pwa/iconUrl';
import BuildStamp from '../components/BuildStamp.astro';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** The unprefixed path, for the canonical and hreflang links (`/`, `/login/`, …). */
  path: string;
  /** Sign-in and the keys page are nobody's search result. */
  noindex?: boolean;
}

const { title, description, lang, path, noindex = false } = Astro.props;
const t = useTranslations(lang);
const origin = 'https://everyrpg.korczak.xyz';
const href = (l: Lang) => `${origin}${l === 'pl' ? `/pl${path}` : path}`;
const recoveryStrings = {
  title: t('hydrationError.title'),
  message: t('hydrationError.message'),
  reload: t('hydrationError.reload'),
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <title>{title}</title>
    <meta name="description" content={description ?? t('rpg.desc')} />
    <link rel="canonical" href={href(lang)} />
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="alternate" hreflang="pl" href={href('pl')} />
    <link rel="alternate" hreflang="x-default" href={href('en')} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={iconUrl('rpg-192.png')} type="image/png" />
    <link rel="manifest" href={`/manifests/${lang}.webmanifest`} />
    <link rel="apple-touch-icon" href={iconUrl('rpg-180.png')} />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={t('pwa.rpg.short')} />
    <script is:inline define:vars={{ recoveryStrings }}>
      window.__islandRecoveryI18n = recoveryStrings;
    </script>
    <script is:inline set:html={islandRecovery}></script>
    <script>
      import { initSentry } from '../../src/lib/sentry';

      initSentry('page');
    </script>
  </head>
  <body>
    <slot />
    <BuildStamp />
  </body>
</html>

<style is:global>
  :root {
    /* The same four insets Layout.astro defines, which the game's touch controls and immersive
       mode are positioned from (styles/rpg.css). Without them an installed iPhone puts the stick
       under the home bar. Here they are not padding on <html>: the game draws edge to edge and
       insets its own controls. */
    --safe-top: env(safe-area-inset-top);
    --safe-right: env(safe-area-inset-right);
    --safe-bottom: env(safe-area-inset-bottom);
    --safe-left: env(safe-area-inset-left);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    background: #000;
    color: #f1e6cf;
    font-family: Georgia, 'Times New Roman', serif;
  }

  a {
    color: #e0b96a;
  }
</style>
