# Firebase web config for the typing trainer's login + cloud sync.
# These PUBLIC_ values are safe to expose in the client bundle (they are not
# secrets). Copy this file to `.env` and fill in the values from the Firebase
# console (Project settings > General > Your apps > SDK setup and configuration).
#
# You probably do not need to do any of this: the real production values are committed in
# `.env.production`, so a fresh clone already builds the real site.
#
# Which file wins depends on the command, and the two go opposite ways:
#   npm run dev    - mode `development`, which never loads `.env.production`. `.env` governs.
#   npm run build  - mode `production`, where `.env.production` is loaded AFTER `.env` and
#                    therefore overrides it. Editing `.env` will not change a build.
# To point a local *build* somewhere else, use `.env.production.local` (gitignored via `.env*.local`
# on the line below), which is loaded last of all.
#
# If these are left unset, the site builds and runs normally with login/cloud
# sync disabled (localStorage-only).

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=korczak-xyz-501720
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1068962621574
PUBLIC_FIREBASE_APP_ID=

# Web Push (Event Watch). The PUBLIC half of the VAPID pair — safe to publish, it is compiled into
# the browser bundle. `.env.production` holds the production value; the private half lives only in
# Secret Manager and in .secrets/vapid.json locally.
#
# It can never change: rotating it invalidates every push subscription on every device, silently.
#
# Note this one is absent from dev unless you put it here: `.env.production` is not loaded in
# development mode, so web push is simply off in `npm run dev` until you set it in `.env`.
PUBLIC_VAPID_PUBLIC_KEY=
