# The RPG's production build environment: `astro build --mode rpg`, which is what
# .github/workflows/rpg-release.yml runs for every published GitHub release before deploying to
# rpg.korczak.xyz. The site at korczak.xyz keeps following main and is built from
# `.env.production` as before.
#
# Vite loads `.env` and then `.env.<mode>`, so in mode `rpg` THIS file replaces `.env.production`
# rather than adding to it — `.env.production` is not read at all. That is why every value is
# repeated here instead of only the ones that differ.
#
# Everything here is public by construction, for the reasons at the top of `.env.production`.
#
# The backend is the game's own project, korczak-rpg (terraform/rpg/): its own accounts, database
# and asset bucket, so nothing here is shared with korczak.xyz. These values are what
# `terraform output firebase_web_config` prints (rpg-terraform.yml's last step). Every function URL
# the game calls (`rpgDemo`, `rpgApi`) is derived from PUBLIC_FIREBASE_PROJECT_ID.
#
# No VAPID key: Event Watch's push lives on korczak.xyz only.

# Firebase web config — terraform/rpg, `firebase_web_config`.
PUBLIC_FIREBASE_API_KEY=AIzaSyCHKrOSjyI_CE7_49tYc8OWjTfFxz-RxCs
PUBLIC_FIREBASE_AUTH_DOMAIN=korczak-rpg.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=korczak-rpg
# The game's asset bucket. Nothing on the page writes to Storage in this build; the SDK just needs
# a bucket that exists rather than the site's sloper bucket in another project.
PUBLIC_FIREBASE_STORAGE_BUCKET=korczak-rpg-rpg
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=921805700652
PUBLIC_FIREBASE_APP_ID=1:921805700652:web:5d884ec340c92ab8581b89
