# The RPG's production build environment: `astro build --mode rpg`, which is what
# .github/workflows/rpg-release.yml runs for every published GitHub release before deploying to
# rpg.korczak.xyz. The site at korczak.xyz keeps following main and is built from
# `.env.production` as before.
#
# Vite loads `.env` and then `.env.<mode>`, so in mode `rpg` THIS file replaces `.env.production`
# rather than adding to it — `.env.production` is not read at all. That is why every value is
# repeated here instead of only the ones that differ.
#
# Everything here is public by construction, for the reasons at the top of `.env.production`.
#
# For now this is the same backend as korczak.xyz (project korczak-xyz-501720): same accounts, same
# worlds, same functions. When the game gets a GCP project of its own, the Firebase block below is
# the one thing on the client side that changes — every function URL the game calls (`rpgDemo`,
# `rpgApi`) is derived from PUBLIC_FIREBASE_PROJECT_ID.

# Firebase web config — console > Project settings > General > Your apps > SDK setup.
PUBLIC_FIREBASE_API_KEY=AIzaSyByJOvgDZd7Lb3WtcDDJjkTOkAAO6jmGV4
PUBLIC_FIREBASE_AUTH_DOMAIN=korczak-xyz-501720.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=korczak-xyz-501720
# NOT the `…firebasestorage.app` name the console's SDK snippet prints. That names the default
# bucket a Firebase project gets when somebody presses "Get started" in the Storage console, and
# nobody ever did — this value sat here for weeks pointing at a bucket that did not exist, which
# cost nothing only because nothing used it. The bucket that does exist is declared in
# `terraform/storage.tf`, plainly named, and the SDK does not care which kind it is handed.
PUBLIC_FIREBASE_STORAGE_BUCKET=korczak-xyz-501720-sloper
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1068962621574
PUBLIC_FIREBASE_APP_ID=1:1068962621574:web:5f4592aad9fb50b9f00907

# Web Push (Event Watch). Rotating this silently invalidates every push subscription on
# every device, with no error anywhere — so it can never change. See functions/README.md.
PUBLIC_VAPID_PUBLIC_KEY=BGnkRSyA-RSvzD4zR7oy9mgRnFbY89roM9CiX6pESuwvrpF8qwmFg7Sv01mC7iRUVmZG65anvlHclL6K9DIHZAY
