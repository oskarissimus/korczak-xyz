{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "../korczak-xyz/src/utils/events/*.ts",
    "../korczak-xyz/src/utils/transit/*.ts",
    "../korczak-xyz/src/utils/sloper/job.ts",
    "../korczak-xyz/src/utils/backseat/types.ts",
    "../korczak-xyz/src/utils/backseat/flavour.ts",
    "../korczak-xyz/src/utils/backseat/defaults.ts",
    "../korczak-xyz/src/utils/backseat/remarks.ts",
    "../korczak-xyz/src/utils/backseat/vision.ts",
    "../korczak-xyz/src/utils/backseat/demoLimits.ts",
    "../korczak-xyz/src/utils/backseat/liveConfig.ts",
    "../korczak-xyz/src/utils/accountKeys/keys.ts",
    "../korczak-xyz/src/utils/rpg/quest.ts",
    "../korczak-xyz/src/utils/rpg/genesis.ts",
    "../korczak-xyz/src/utils/rpg/place.ts",
    "../korczak-xyz/src/utils/rpg/cost.ts",
    "../korczak-xyz/src/utils/rpg/demoLimits.ts",
    "../korczak-xyz/src/utils/rpg/voicePick.ts"
  ],
  "exclude": [
    "../korczak-xyz/src/utils/events/*.test.ts",
    "../korczak-xyz/src/utils/transit/*.test.ts",
    "src/**/*.test.ts"
  ]
}
