{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "../korczak-xyz/src/utils/events/*.ts"
  ],
  "exclude": [
    "../korczak-xyz/src/utils/events/*.test.ts",
    "src/**/*.test.ts"
  ]
}
